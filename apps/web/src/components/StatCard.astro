---
interface Props {
  label: string;
  value: string | number;
  hint?: string;
  icon?: string;
}
const { label, value, hint, icon } = Astro.props;

const l = label.toLowerCase();
const type = icon || (l.includes('event') ? 'calendar' :
             l.includes('peserta') ? 'users' :
             l.includes('daftar') || l.includes('menunggu') || l.includes('antre') ? 'clipboard' :
             l.includes('pendapatan') || l.includes('lunas') || l.includes('bayar') ? 'wallet' : 'trend');
---

<div class="card stat">
  <div class="stat__header">
    <div class={`stat__icon-box stat__icon-box--${type}`}>
      {type === 'calendar' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      )}
      {type === 'users' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      )}
      {type === 'clipboard' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
        </svg>
      )}
      {type === 'wallet' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
          <circle cx="16" cy="15" r="1"></circle>
        </svg>
      )}
      {type === 'trend' && (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
          <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
      )}
    </div>
    <span class="meta">{label}</span>
  </div>
  <b>{value}</b>
  {hint && <span class="stat__hint">{hint}</span>}
</div>
