---
const year = new Date().getFullYear();
---
<footer class="footer on-dark">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a class="logo" href="/">
          <svg viewBox="0 0 32 32" aria-hidden="true" width="28" height="28">
            <rect width="32" height="32" rx="8" fill="#2563eb"/>
            <path d="M9 11h14M9 16h14M9 21h8" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
          </svg>
          PlatformEvent<span class="brand-dot">.</span>
        </a>
        <p style="margin-top:14px;max-width:34ch">Satu platform tepercaya untuk menemukan event, mengamankan tiket kuota real-time, dan memantau status pesanan.</p>
      </div>
      <nav aria-label="Jelajahi">
        <h2>Jelajahi</h2>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/events">Semua Event</a></li>
          <li><a href="/events?price=free">Event Gratis</a></li>
          <li><a href="/partnership">Partnership Mitra</a></li>
          <li><a href="/blog">Kabar & Cerita</a></li>
          <li><a href="/kontak">Kontak Bantuan</a></li>
        </ul>
      </nav>
      <nav aria-label="Akun Peserta">
        <h2>Akun Peserta</h2>
        <ul>
          <li><a href="/login">Masuk Akun</a></li>
          <li><a href="/register">Daftar Akun Baru</a></li>
          <li><a href="/pesanan">Riwayat Pesanan</a></li>
          <li><a href="/tiket-saya">Tiket Saya</a></li>
        </ul>
      </nav>
      <nav aria-label="Informasi Legal">
        <h2>Legal & Panduan</h2>
        <ul>
          <li><a href="/tentang">Tentang Platform</a></li>
          <li><a href="/privacy">Kebijakan Privasi</a></li>
          <li><a href="/terms">Syarat & Ketentuan</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer__legal">
      <span>© {year} PlatformEvent Indonesia. Hak cipta dilindungi undang-undang.</span>
      <a href="/kontak">Pusat Bantuan & Kontak</a>
    </div>
  </div>
</footer>
