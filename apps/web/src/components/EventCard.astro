---
import { fmtDate, mediaUrl, rupiah } from '../lib/utils/format';
interface Props { e: Record<string, any> }
const { e } = Astro.props;
const img = mediaUrl(e.poster_path);
const total = Number(e.total_quota) || 0;
const available = Math.max(0, Number(e.available ?? 0));
const taken = Math.max(0, total - available);
const percentTaken = total > 0 ? Math.min(100, Math.max(0, Math.round((taken / total) * 100))) : 0;
const full = (e.status === 'published' && available <= 0) || e.status === 'registration_closed';
const isUrgent = available > 0 && (available <= 5 || (total > 0 && (available / total) <= 0.2));
const isFree = Number(e.min_price) === 0;
---
<article class="card event-card">
  <div class="event-card__img-wrap">
    {img ? (
      <img class="event-card__img" src={img} alt={e.poster_alt || `Poster ${e.title}`} width="640" height="360" loading="lazy" />
    ) : (
      <div class="event-card__ph" aria-hidden="true">{e.title?.[0]}</div>
    )}

    {e.category_name && (
      <span class="event-card__badge-tag">{e.category_name}</span>
    )}

    <span class="event-card__badge-format">
      {e.event_type === 'online' ? '🟢 Online' : `📍 ${e.city || e.venue_name || 'Venue'}`}
    </span>
  </div>

  <div class="event-card__body">
    <div class="event-card__meta-row">
      <svg class="event-card__meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
        <line x1="16" y1="2" x2="16" y2="6" />
        <line x1="8" y1="2" x2="8" y2="6" />
        <line x1="3" y1="10" x2="21" y2="10" />
      </svg>
      <span>{fmtDate(e.start_at)}</span>
    </div>

    <h3><a href={`/events/${e.slug}`}>{e.title}</a></h3>

    {total > 0 && (
      <div class="event-card__quota">
        <div class="event-card__quota-info">
          <span class={`event-card__quota-text ${isUrgent ? 'is-urgent' : ''} ${full ? 'is-full' : ''}`}>
            {full ? (
              'Kuota Habis'
            ) : isUrgent ? (
              <>🔥 Sisa <b>{available}</b> slot lagi!</>
            ) : (
              <>Sisa <b>{available}</b> slot</>
            )}
          </span>
          <span class="event-card__quota-percent">
            {full ? 'Penuh' : `${percentTaken}% terisi`}
          </span>
        </div>
        <div class="event-card__bar" role="progressbar" aria-valuenow={percentTaken} aria-valuemin="0" aria-valuemax="100" aria-label={`Kuota terisi ${percentTaken}%`}>
          <div
            class={`event-card__bar-fill ${isUrgent ? 'is-urgent' : ''} ${full ? 'is-full' : ''}`}
            style={`width: ${Math.max(percentTaken, 3)}%;`}
          ></div>
        </div>
      </div>
    )}

    <div class="event-card__foot">
      <div class="price-wrap">
        <span class="price-label">Mulai dari</span>
        <span class={`price ${isFree ? 'price--free' : ''}`}>
          {isFree ? 'Gratis' : rupiah(e.min_price)}
        </span>
      </div>
      <a class="btn btn--secondary btn--sm" href={`/events/${e.slug}`}>
        {full ? 'Detail' : 'Detail →'}
        <span class="sr-only">: {e.title}</span>
      </a>
    </div>
  </div>
</article>
