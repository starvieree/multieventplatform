---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import DataTable from '../../../components/DataTable.astro';
import Badge from '../../../components/Badge.astro';
import StatCard from '../../../components/StatCard.astro';
import { adminDb } from '../../../lib/supabase/server';
import { can } from '../../../lib/admin-resources';
import { fmtDate } from '../../../lib/utils/format';

if (!can(Astro.locals, 'queues.view')) return Astro.rewrite('/404');
const db = adminDb(), status = Astro.url.searchParams.get('status') ?? '';
const [{ data: sum }, { data: rows }] = await Promise.all([
  db.rpc('admin_summary', { p_from: new Date(Date.now() - 864e5).toISOString(), p_to: new Date().toISOString() }),
  (status ? db.from('queue_requests').select('id,status,error_code,retry_count,quantity,queued_at,processed_at,event:events(title)').eq('status', status) : db.from('queue_requests').select('id,status,error_code,retry_count,quantity,queued_at,processed_at,event:events(title)')).order('queued_at', { ascending: false }).limit(50)
]);

const h = (sum as any)?.health ?? {}, manage = can(Astro.locals, 'queues.manage');
const workerAge = h.worker_last_seen ? Math.round((Date.now() - +new Date(h.worker_last_seen)) / 1000) : null;
const list = (rows ?? []).map((r: any) => ({ ...r, retry: manage && r.status === 'failed' }));
---

<PanelLayout title="Antrean & Worker" variant="admin" crumbs={[{ label: 'Admin', href: '/admin/dashboard' }, { label: 'Antrean & Worker' }]}>
  <div class="row between" style="align-items:flex-end; margin-bottom: 24px; flex-wrap:wrap; gap:16px;">
    <div>
      <h1>Antrean & Worker Engine</h1>
      <p class="muted small" style="margin:4px 0 0; color:#6B7280;">Monitoring real-time antrean pendaftaran tiket berkecepatan tinggi (LavinMQ).</p>
    </div>
    <div class="row" style="align-items:center; gap:8px;">
      <span class="muted small">Status Worker:</span>
      {workerAge !== null && workerAge < 60 ? (
        <Badge status="active" label={`Aktif (${workerAge} dtk lalu)`} />
      ) : (
        <Badge status="failed" label={workerAge === null ? 'Belum terlihat' : 'Tidak aktif'} />
      )}
    </div>
  </div>

  <div class="grid grid--4" style="margin:0 0 24px 0; gap:20px;">
    <StatCard label="Menunggu (Queued)" value={h.queue_queued ?? 0} hint="Dalam pipeline broker" />
    <StatCard label="Sedang Diproses" value={h.queue_processing ?? 0} hint="Sedang dialokasikan" />
    <StatCard label="Gagal (Dead-letter)" value={h.queue_failed ?? 0} hint="Perlu ditinjau / retry" />
    <StatCard label="Outbox Belum Terkirim" value={h.outbox_pending ?? 0} hint="Email & webhook pending" />
  </div>

  <div class="card card--pad" style="margin-bottom: 20px; padding: 16px 20px;">
    <form method="get" class="row" style="gap:12px; align-items:center;">
      <label class="sr-only" for="s">Status Permintaan</label>
      <select class="input" id="s" name="status" style="max-width:240px">
        <option value="">Semua status antrean</option>
        {['queued', 'processing', 'accepted', 'rejected', 'failed', 'expired'].map((s) => (
          <option selected={s === status} value={s}>{s}</option>
        ))}
      </select>
      <button class="btn btn--secondary btn--sm">Terapkan</button>
      {status && <a href="/admin/dashboard/queues" class="btn btn--secondary btn--sm" style="color:#6B7280;">Reset</a>}
    </form>
  </div>

  <div class="table-wrap">
    <table class="table">
      <caption class="sr-only">Permintaan antrean pendaftaran</caption>
      <thead>
        <tr>
          <th scope="col">Event</th>
          <th scope="col">Status</th>
          <th scope="col">Jumlah Tiket</th>
          <th scope="col">Percobaan</th>
          <th scope="col">Waktu Masuk</th>
          <th scope="col">Kode Error</th>
          <th scope="col">Aksi</th>
        </tr>
      </thead>
      <tbody>
        {list.map((r: any) => (
          <tr>
            <td><b>{r.event?.title ?? '—'}</b></td>
            <td><Badge status={r.status} /></td>
            <td>{r.quantity}</td>
            <td>{r.retry_count}</td>
            <td>{fmtDate(r.queued_at, true)}</td>
            <td><code>{r.error_code ?? '—'}</code></td>
            <td>
              {r.retry ? (
                <button class="btn btn--secondary btn--sm" data-action={`/api/v1/admin/queues/requests/${r.id}/retry`} data-confirm="Antrekan ulang permintaan ini? Prosesnya idempotent, tidak membuat reservasi ganda.">
                  Retry
                </button>
              ) : '—'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {list.length === 0 && (
    <div class="card card--pad" style="margin-top:20px; text-align:center; padding: 48px 24px;">
      <h3 style="margin-bottom:6px; color:#111827;">Tidak ada antrean pada status ini</h3>
      <p class="muted small" style="margin:0;">Seluruh permintaan antrean pendaftaran telah berhasil diproses.</p>
    </div>
  )}

  <script>import '../../../scripts/admin-actions.ts';</script>
</PanelLayout>
