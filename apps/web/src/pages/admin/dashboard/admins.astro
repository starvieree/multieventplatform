---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import Badge from '../../../components/Badge.astro';
import FormField from '../../../components/FormField.astro';
import { adminDb } from '../../../lib/supabase/server';
import { can } from '../../../lib/admin-resources';

if (!can(Astro.locals, 'admins.manage')) return Astro.rewrite('/404');
const { data } = await adminDb().from('user_roles').select('user_id, role:roles!inner(name), profile:profiles(full_name,email,account_status)').in('role.name', ['admin', 'super_admin']);
const isSuper = Astro.locals.roles.includes('super_admin');
---

<PanelLayout title="Admin & Hak Akses" variant="admin" crumbs={[{ label: 'Admin', href: '/admin/dashboard' }, { label: 'Admin & Hak Akses' }]}>
  <div style="margin-bottom: 24px;">
    <h1>Admin & Hak Akses (RBAC)</h1>
    <p class="muted small" style="margin:4px 0 0; color:#6B7280;">Kelola akun pengelola platform, hak akses khusus, dan wewenang operasional.</p>
  </div>

  <div class="grid grid--2 admins-grid" style="align-items:start; gap:24px;">
    <div>
      <div class="table-wrap">
        <table class="table">
          <caption class="sr-only">Daftar admin platform</caption>
          <thead>
            <tr>
              <th scope="col">Nama</th>
              <th scope="col">Email</th>
              <th scope="col">Peran</th>
              <th scope="col">Status</th>
              <th scope="col">Aksi</th>
            </tr>
          </thead>
          <tbody>
            {(data ?? []).map((r: any) => (
              <tr>
                <td><b>{r.profile?.full_name ?? '—'}</b></td>
                <td>{r.profile?.email}</td>
                <td>
                  <span class={`badge ${r.role.name === 'super_admin' ? 'badge--ok' : 'badge--wait'}`}>
                    {r.role.name === 'super_admin' ? 'Super Admin' : 'Admin'}
                  </span>
                </td>
                <td><Badge status={r.profile?.account_status} /></td>
                <td>
                  {r.user_id !== Astro.locals.user?.id && (isSuper || r.role.name === 'admin') ? (
                    <button class="btn btn--secondary btn--sm" data-action={`/api/v1/admin/admins/${r.user_id}`} data-method="DELETE" data-body={JSON.stringify({ role: r.role.name })} data-confirm="Cabut peran ini? Akun tersebut tidak lagi dapat mengakses panel admin.">
                      Cabut
                    </button>
                  ) : (
                    <span class="muted small">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <form class="form card card--pad" data-json-form data-endpoint="/api/v1/admin/admins" data-success="Peran admin berhasil diberikan." data-redirect="/admin/dashboard/admins">
        <h2 style="font-size:1.1rem; font-weight:600; color:#111827; margin:0 0 16px; border-bottom:1px solid #F3F4F6; padding-bottom:10px;">
          Berikan Akses Admin Baru
        </h2>
        <FormField name="email" type="email" label="Email Akun Terdaftar" required hint="Pengguna harus sudah mendaftar akun di web terlebih dahulu." />
        <FormField name="role" type="select" label="Tingkat Peran" required options={isSuper ? ['admin', 'super_admin'] : ['admin']} />
        <div data-feedback hidden style="margin-top:12px;"></div>
        <button class="btn" type="submit" style="margin-top:16px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Berikan Hak Akses</span>
        </button>
      </form>
    </div>
  </div>

  <script>import '../../../scripts/json-form.ts'; import '../../../scripts/admin-actions.ts';</script>
</PanelLayout>
