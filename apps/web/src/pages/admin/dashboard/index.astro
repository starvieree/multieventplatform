---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import StatCard from '../../../components/StatCard.astro';
import Badge from '../../../components/Badge.astro';
import { adminDb } from '../../../lib/supabase/server';
import { fmtDate, rupiah } from '../../../lib/utils/format';

const days = [7, 30, 90].includes(Number(Astro.url.searchParams.get('days'))) ? Number(Astro.url.searchParams.get('days')) : 30;
const { data: s, error } = await adminDb().rpc('admin_summary', { p_from: new Date(Date.now() - days * 864e5).toISOString(), p_to: new Date().toISOString() });
const d = (s ?? {}) as any, h = d.health ?? {};
const series: { day: string; count: number }[] = d.registrations_by_day ?? [];
const max = Math.max(1, ...series.map((x) => x.count));
const workerAge = h.worker_last_seen ? Math.round((Date.now() - +new Date(h.worker_last_seen)) / 1000) : null;
const workerOk = workerAge !== null && workerAge < 60;
---

<PanelLayout title="Dashboard Admin" variant="admin" crumbs={[{ label: 'Admin', href: '/admin/dashboard' }, { label: 'Dashboard' }]}>
  <div class="row between dash-header-row" style="align-items:flex-end; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1>Dashboard Ringkasan</h1>
      <p class="muted small" style="margin:4px 0 0; color: #6B7280;">Pantau performa event, volume pendaftaran, dan kesehatan sistem secara real-time.</p>
    </div>
    <form method="get" class="row dash-days-form" style="gap:10px;">
      <label class="sr-only" for="d">Rentang Waktu</label>
      <select class="input" id="d" name="days" style="padding: 8px 14px; font-size: 0.85rem;">
        {[7, 30, 90].map((n) => <option value={n} selected={n === days}>{n} hari terakhir</option>)}
      </select>
      <button class="btn btn--secondary btn--sm">Terapkan</button>
    </form>
  </div>

  {error ? (
    <div class="alert alert--bad" role="alert" style="margin-top:16px">Ringkasan analitik belum dapat dimuat saat ini.</div>
  ) : (
    <>
      <div class="grid grid--4 dash-stats-grid" style="margin:0 0 24px 0; gap: 20px;">
        <StatCard label="Event Aktif" value={d.events ?? 0} hint="Event berstatus aktif" />
        <StatCard label="Peserta Terdaftar" value={d.participants ?? 0} hint="Akun audiens unik" />
        <StatCard label={`Pendaftaran (${days} hari)`} value={d.registrations ?? 0} hint={`${d.confirmed ?? 0} terkonfirmasi lunas`} />
        <StatCard label="Pendapatan Lunas" value={rupiah(d.revenue_paid ?? 0)} hint="Pembayaran terverifikasi" />
      </div>

      <div class="grid grid--2" style="align-items:start; gap: 24px;">
        <section class="card card--pad">
          <div class="row between" style="margin-bottom: 16px; border-bottom: 1px solid #F3F4F6; padding-bottom: 12px;">
            <h2 style="font-size:1.05rem; font-weight: 600; color: #111827; margin:0;">Tren Pendaftaran Harian</h2>
            <span class="muted small">{days} hari terakhir</span>
          </div>
          {series.length ? (
            <div class="bars" role="img" aria-label={`Grafik pendaftaran per hari, total ${d.registrations}`}>
              {series.map((x) => (
                <i style={`height:${Math.max(4, (x.count / max) * 100)}%`} title={`${fmtDate(x.day)}: ${x.count} pendaftaran`}></i>
              ))}
            </div>
          ) : (
            <p class="muted small" style="padding: 24px 0; text-align: center;">Belum ada pendaftaran pada rentang tanggal ini.</p>
          )}
        </section>

        <section class="card card--pad">
          <div class="row between" style="margin-bottom: 16px; border-bottom: 1px solid #F3F4F6; padding-bottom: 12px;">
            <h2 style="font-size:1.05rem; font-weight: 600; color: #111827; margin:0;">Event Terpopuler</h2>
            <span class="muted small">Peringkat minat</span>
          </div>
          {(d.top_events ?? []).length ? (
            <ol style="padding-left:20px; margin:0; display:flex; flex-direction:column; gap: 10px;">
              {d.top_events.map((e: any) => (
                <li style="font-size: 0.875rem; color: #1F2A37; font-weight: 500;">
                  <span style="color:#111827; font-weight:600;">{e.title}</span>
                  <span class="meta" style="color:#6B7280; font-size:0.8rem; margin-left:6px;">· {e.confirmed} tiket terkonfirmasi</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="muted small" style="padding: 24px 0; text-align: center;">Belum ada data event terpopuler.</p>
          )}
        </section>

        <section class="card card--pad">
          <div class="row between" style="margin-bottom: 16px; border-bottom: 1px solid #F3F4F6; padding-bottom: 12px;">
            <h2 style="font-size:1.05rem; font-weight: 600; color: #111827; margin:0;">Kesehatan Sistem & Worker</h2>
            <span class="muted small">Engine status</span>
          </div>
          <dl class="kv">
            <dt>Database Supabase</dt>
            <dd><Badge status="active" label="OK" /></dd>
            <dt>LavinMQ Worker</dt>
            <dd>
              {workerOk ? (
                <Badge status="active" label={`Aktif (${workerAge} dtk lalu)`} />
              ) : (
                <Badge status="failed" label={workerAge === null ? 'Belum pernah terlihat' : `Tidak aktif (${Math.round(workerAge / 60)} mnt)`} />
              )}
            </dd>
            <dt>Antrean menunggu</dt>
            <dd>{h.queue_queued ?? 0} antrean · {h.queue_processing ?? 0} diproses</dd>
            <dt>Antrean gagal</dt>
            <dd>{h.queue_failed ? <a href="/admin/dashboard/queues" style="color:#EF4444; font-weight:600;">{h.queue_failed} perlu ditinjau</a> : '0 gagal'}</dd>
            <dt>Outbox belum terkirim</dt>
            <dd>{h.outbox_pending ?? 0} pesan</dd>
            <dt>Webhook terakhir valid</dt>
            <dd>{fmtDate(h.webhook_last_valid, true)}</dd>
            <dt>Signature invalid (24 jam)</dt>
            <dd>{h.webhook_invalid_24h ?? 0}</dd>
            <dt>Pending lewat batas</dt>
            <dd>{h.stale_pending_tx ?? 0} transaksi</dd>
          </dl>
        </section>

        <section class="card card--pad">
          <div class="row between" style="margin-bottom: 16px; border-bottom: 1px solid #F3F4F6; padding-bottom: 12px;">
            <h2 style="font-size:1.05rem; font-weight: 600; color: #111827; margin:0;">Aktivitas Terbaru</h2>
            <span class="muted small">Jejak log</span>
          </div>
          {(d.recent_activity ?? []).length ? (
            <ul class="stack" style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:12px;">
              {d.recent_activity.map((a: any) => (
                <li style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #F3F4F6; font-size:0.85rem;">
                  <div>
                    <b style="color:#111827; font-weight:600;">{a.action}</b>
                    <span class="meta" style="color:#6B7280; font-size:0.8rem; margin-left:6px;">({a.resource_type})</span>
                  </div>
                  <span class="meta" style="color:#9CA3AF; font-size:0.775rem;">{fmtDate(a.created_at, true)}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted small" style="padding: 24px 0; text-align: center;">Belum ada log aktivitas.</p>
          )}
        </section>
      </div>
    </>
  )}
</PanelLayout>
