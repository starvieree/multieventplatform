---
import PanelLayout from '../../../../layouts/PanelLayout.astro';
import EventForm from '../../../../components/EventForm.astro';
import Badge from '../../../../components/Badge.astro';
import { adminDb } from '../../../../lib/supabase/server';
import { can } from '../../../../lib/admin-resources';

if (!can(Astro.locals, 'events.manage') || !/^[0-9a-f-]{36}$/i.test(Astro.params.id!)) return Astro.rewrite('/404');
const db = adminDb(), id = Astro.params.id!;
const [{ data: ev }, { data: tickets }, { data: fields }, { data: cats }] = await Promise.all([
  db.from('events').select('*').eq('id', id).maybeSingle(),
  db.from('ticket_categories').select('*').eq('event_id', id).order('price'),
  db.from('event_form_fields').select('*').eq('event_id', id).order('sort_order'),
  db.from('event_categories').select('id,name').eq('is_active', true).order('name')
]);
if (!ev) return Astro.rewrite('/404');

const next: Record<string, [string, string, string][]> = {
  draft: [
    ['published', 'Publikasikan', 'Publikasikan event ini? Event akan tampil di katalog publik.'],
    ['archived', 'Arsipkan', 'Arsipkan event?']
  ],
  published: [
    ['registration_closed', 'Tutup pendaftaran', 'Tutup pendaftaran sekarang?'],
    ['archived', 'Arsipkan', 'Arsipkan event? Event hilang dari katalog.'],
    ['draft', 'Tarik ke draf', 'Kembalikan ke draf? Event hilang dari katalog.']
  ],
  registration_closed: [
    ['published', 'Buka kembali', 'Buka kembali pendaftaran?'],
    ['ongoing', 'Tandai berlangsung', 'Tandai event berlangsung?']
  ],
  ongoing: [
    ['completed', 'Tandai selesai', 'Tandai event selesai?']
  ],
  completed: [
    ['archived', 'Arsipkan', 'Arsipkan event?']
  ],
  archived: [
    ['draft', 'Kembalikan ke draf', 'Kembalikan ke draf?']
  ]
};

const ACTION_MAP: Record<string, { cls: string; icon: string }> = {
  registration_closed: { cls: 'btn-status--warning', icon: 'lock' },
  archived: { cls: 'btn-status--danger', icon: 'archive' },
  draft: { cls: 'btn-status--neutral', icon: 'undo' },
  published: { cls: 'btn-status--primary', icon: 'rocket' },
  ongoing: { cls: 'btn-status--ongoing', icon: 'play' },
  completed: { cls: 'btn-status--completed', icon: 'check' }
};
---

<PanelLayout title={ev.title} variant="admin" crumbs={[{ label: 'Admin', href: '/admin/dashboard' }, { label: 'Event', href: '/admin/dashboard/events' }, { label: ev.title }]}>
  <div class="row between" style="margin-bottom:20px; align-items:center; flex-wrap:wrap; gap:16px;">
    <div class="row" style="gap:12px; align-items:center;">
      <h1 style="margin:0; font-size:1.5rem;">{ev.title}</h1>
      <Badge status={ev.status} />
    </div>

    <div class="row" style="gap:8px; align-items:center; flex-wrap:wrap;">
      {(next[ev.status] ?? []).map(([s, l, c]) => {
        const conf = ACTION_MAP[s] ?? { cls: 'btn-status--neutral', icon: 'chevron' };
        return (
          <button
            class={`btn btn-status btn--sm ${conf.cls}`}
            type="button"
            data-event-status={s}
            data-id={ev.id}
            data-confirm={c}
          >
            {conf.icon === 'lock' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            )}
            {conf.icon === 'archive' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="21 8 21 21 3 21 3 8"></polyline>
                <rect x="1" y="3" width="22" height="5"></rect>
                <line x1="10" y1="12" x2="14" y2="12"></line>
              </svg>
            )}
            {conf.icon === 'undo' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7v6h6"></path>
                <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"></path>
              </svg>
            )}
            {conf.icon === 'rocket' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
              </svg>
            )}
            {conf.icon === 'play' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            )}
            {conf.icon === 'check' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            )}
            <span>{l}</span>
          </button>
        );
      })}

      {ev.status !== 'draft' && (
        <a
          class="btn btn-status btn--sm btn-status--view"
          href={`/events/${ev.slug}`}
          target="_blank"
          rel="noopener"
          title="Buka halaman publik event ini di tab baru"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Lihat halaman publik</span>
        </a>
      )}
    </div>
  </div>

  {Astro.url.searchParams.get('saved') && (
    <div class="alert alert--ok" role="status" style="margin-bottom:16px">
      Event dibuat. Tambahkan kategori tiket lalu publikasikan.
    </div>
  )}

  <EventForm ev={ev} tickets={tickets ?? []} fields={fields ?? []} categories={cats ?? []} />
</PanelLayout>
