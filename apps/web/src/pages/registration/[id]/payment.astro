---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { fmtDate, rupiah } from '../../../lib/utils/format';
import { QrisService, parseQris } from '../../../lib/services/qris.service';

const sb = Astro.locals.supabase;
const { data: r } = await sb
  .from('registrations')
  .select('id,registration_code,registration_status,total_amount,quantity,event:events(title,slug),ticket:ticket_categories(name),reservations:quota_reservations(status,expires_at)')
  .eq('id', Astro.params.id!)
  .maybeSingle();

if (!r) return Astro.rewrite('/404');
if (r.registration_status === 'draft') return Astro.redirect(`/registration/${r.id}/form`);
if (r.registration_status === 'expired') {
  const evSlug = (r as any).event?.slug;
  return Astro.redirect(evSlug ? `/events/${evSlug}?expired=1` : '/events');
}
if (r.registration_status !== 'awaiting_payment') return Astro.redirect(`/registration/${r.id}/status`);

const res = (r as any).reservations?.find((x: any) => x.status === 'reserved' && +new Date(x.expires_at) > Date.now());
const ev = (r as any).event;

if (!res) {
  const evSlug = ev?.slug;
  return Astro.redirect(evSlug ? `/events/${evSlug}?expired=1` : '/events');
}

// Ambil info merchant dari QRIS statis di env
const qrisService = new QrisService();
const staticQris = qrisService.getStaticQris();
const merchantInfo = parseQris(staticQris);
const merchantAcquirer = merchantInfo.acquirer || 'ShopeePay';
const merchantName = merchantInfo.merchantName || 'musgraph';
const merchantLocation = `${merchantInfo.city || 'BANYUWANGI'}${merchantInfo.postalCode ? ' • ' + merchantInfo.postalCode : ''}`;
---

<PublicLayout title="Pembayaran QRIS Dinamis" noindex>
  <!-- Celebratory Full-Screen Success Modal (Hidden by default, shown only when .is-active is added) -->
  <div
    id="success-modal"
    class="modal-backdrop"
  >
    <div class="modal-card">
      <!-- Glow ambient -->
      <div class="modal-glow"></div>

      <!-- Checkmark Badge Icon -->
      <div class="modal-icon-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <div style="text-align: center;">
        <span class="modal-pill">
          ✓ Pembayaran Berhasil Terverifikasi
        </span>
        <h2 style="font-size: 1.85rem; font-weight: 850; color: #0f172a; margin: 10px 0 6px;">
          Transaksi <span style="color: #10b981;">LUNAS!</span>
        </h2>
        <p style="font-size: 13.5px; color: #64748b; margin: 0 auto; max-width: 380px; line-height: 1.5;">
          Notifikasi uang masuk telah berhasil diterima dan diverifikasi otomatis oleh server. Tiket Anda siap digunakan!
        </p>
      </div>

      <!-- Receipt Details Table -->
      <div class="receipt-box">
        <div class="receipt-row">
          <span class="muted small">Order ID / Booking:</span>
          <span id="modal-order-id" class="receipt-val font-mono" style="color: #2563eb; font-weight: 700;">{r.registration_code}</span>
        </div>
        <div class="receipt-row">
          <span class="muted small">Nominal Diterima:</span>
          <span id="modal-amount" class="receipt-val font-mono" style="color: #059669; font-weight: 800; font-size: 15px;">-</span>
        </div>
        <div class="receipt-row">
          <span class="muted small">Nama Merchant:</span>
          <span id="modal-merchant" class="receipt-val font-semibold">{merchantName}</span>
        </div>
        <div class="receipt-row">
          <span class="muted small">Metode Pembayaran:</span>
          <span id="modal-acquirer" class="receipt-badge">QRIS {merchantAcquirer}</span>
        </div>
        <div class="receipt-row" style="border-bottom: none; padding-bottom: 0;">
          <span class="muted small">Waktu Verifikasi:</span>
          <span id="modal-time" class="receipt-val font-mono text-muted">-</span>
        </div>
      </div>

      <!-- Action Button -->
      <div style="margin-top: 22px;">
        <button
          type="button"
          id="btn-close-modal"
          class="btn"
          style="width: 100%; padding: 14px; font-size: 15px; font-weight: 750; background: #10b981; border-color: #10b981; color: #ffffff; box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.4);"
        >
          Lihat E-Tiket Saya →
        </button>
      </div>
    </div>
  </div>

  <section class="wrap" style="max-width: 720px; padding: 40px 0 80px;">
    {!res ? (
      <div class="card" style="padding: 40px 24px; text-align: center; border-radius: 24px; box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.1);">
        <div style="font-size: 3rem; margin-bottom: 12px;">⏳</div>
        <h1 style="font-size: 1.8rem; font-weight: 750; margin-bottom: 10px;">Waktu Pembayaran Telah Berakhir</h1>
        <p class="muted" style="max-width: 460px; margin: 0 auto 24px; line-height: 1.6;">
          Batas waktu reservasi tiket Anda telah berakhir dan kuota telah dilepas kembali ke publik. Anda dapat mendaftar ulang bila tiket masih tersedia.
        </p>
        <div class="row" style="justify-content: center; gap: 12px;">
          {ev?.slug && <a class="btn" href={`/events/${ev.slug}#daftar`}>Daftar Ulang Sekarang</a>}
          <a class="btn btn--secondary" href={`/registration/${r.id}/status`}>Cek Status Tiket</a>
        </div>
      </div>
    ) : (
      <div id="pay" data-id={r.id} data-amount={r.total_amount} data-event-url={ev?.slug ? `/events/${ev.slug}` : '/events'}>
        <!-- Header -->
        <div style="margin-bottom: 24px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
            <span class="hero__badge" style="font-size: 11px;">
              Standard EMVCo • Live Auto Settlement
            </span>
          </div>
          <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0;">QRIS Dinamis & Live Settlement</h1>
          <p class="muted small" style="margin-top: 6px;">
            Pindai kode QRIS dinamis di bawah ini. Begitu uang masuk ke akun merchant, sistem akan langsung memperbarui status order menjadi <strong style="color: #059669;">Lunas secara real-time</strong>.
          </p>
        </div>

        <!-- Active Live Beacon & Order ID Bar -->
        <div class="status-bar-card">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div>
              <span class="meta" style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Status Order</span>
              <div style="margin-top: 4px;">
                <span id="order-status-badge" class="badge-waiting">
                  <span class="dot-ping"></span>
                  Menunggu Scan
                </span>
              </div>
            </div>

            <div style="text-align: right;">
              <span class="meta" style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Berlaku Hingga</span>
              <div id="countdown-timer" class="countdown-display">
                ⏱️ 15:00
              </div>
            </div>
          </div>

          <div style="margin-top: 12px; pt: 12px; border-top: 1px solid var(--dp-color-rule); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 12px;">
            <span class="muted">Active Order ID:</span>
            <span id="current-order-id" class="font-mono font-bold" style="color: var(--dp-color-accent); font-size: 13px;">
              {r.registration_code}
            </span>
          </div>
        </div>

        <!-- Main QRIS Card -->
        <div class="card stack qris-main-box" style="padding: 28px; border-radius: 24px; box-shadow: 0 16px 40px -12px rgba(15, 23, 42, 0.1);">
          <!-- Rincian Pemesanan Ringkas -->
          <div style="border-bottom: 1px solid var(--dp-color-rule); padding-bottom: 16px; margin-bottom: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap;">
              <div>
                <span class="meta" style="font-size: 11.5px; font-weight: 700; color: var(--dp-color-accent); text-transform: uppercase;">
                  Event
                </span>
                <h2 style="font-size: 1.25rem; margin: 4px 0 0; line-height: 1.3;">{ev.title}</h2>
              </div>
              <div style="text-align: right;">
                <span class="meta" style="font-size: 11.5px;">Kategori Tiket</span>
                <div style="font-size: 1.05rem; font-weight: 700; color: var(--dp-color-ink);">
                  {(r as any).ticket.name} × {r.quantity}
                </div>
              </div>
            </div>
          </div>

          <!-- Merchant Header -->
          <div style="text-align: center; padding: 10px 0 6px;">
            <span class="merchant-badge">
              Merchant QRIS {merchantAcquirer}
            </span>
            <h3 id="display-merchant-name" style="font-size: 1.2rem; font-weight: 800; margin: 6px 0 2px;">
              {merchantName}
            </h3>
            <p id="display-merchant-loc" class="muted" style="font-size: 12px; margin: 0;">
              {merchantLocation}
            </p>
          </div>

          <!-- QR Code Display Box -->
          <div class="qr-preview-wrapper">
            <div class="qr-box">
              <div id="qris-loading" style="padding: 60px 20px; text-align: center;">
                <div class="spinner-dot"></div>
                <div style="font-weight: 600; font-size: 13.5px; color: #475569; margin-top: 14px;">
                  Menghasilkan QRIS Dinamis & Kode Unik...
                </div>
              </div>

              <div id="qris-content" hidden style="position: relative;">
                <img
                  id="qris-img"
                  src=""
                  alt="QRIS Dinamis Standar EMVCo"
                  class="qr-image"
                />

                <!-- Expired QR Overlay -->
                <div id="qr-expired-overlay" class="expired-overlay" hidden>
                  <div class="expired-icon-box">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 28px; height: 28px;">
                      <path d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </div>
                  <div>
                    <h4 style="color: #dc2626; font-size: 16px; font-weight: 800; margin: 0 0 4px;">
                      QRIS Kadaluarsa
                    </h4>
                    <p style="font-size: 12px; color: #64748b; margin: 0; max-width: 220px; line-height: 1.4;">
                      Batas waktu telah habis. Kode QR ini tidak dapat menerima pembayaran lagi.
                    </p>
                  </div>
                  <button
                    type="button"
                    id="btn-expired-renew"
                    class="btn btn--secondary"
                    style="font-size: 12px; padding: 8px 16px; margin-top: 6px;"
                  >
                    🔄 Perbarui QRIS
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Total Amount Locked Display (Tag 54) -->
          <div class="locked-amount-card">
            <span class="locked-amount-label">
              Nominal Terkunci (Tag 54)
            </span>
            <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin: 4px 0;">
              <span id="qris-exact-amount" class="locked-amount-value font-mono">
                {rupiah(r.total_amount)}
              </span>
              <button
                type="button"
                id="copy-amount-btn"
                class="copy-pill-btn"
                title="Salin nominal persis"
              >
                Salin Nominal
              </button>
            </div>
            <div id="qris-unique-badge" style="font-size: 11.5px; color: #0284c7; font-weight: 600; margin-top: 4px;">
              * Nominal pas sesuai harga tiket event yang ditentukan admin
            </div>
            <span style="font-size: 11.5px; color: #64748b; display: block; margin-top: 4px;">
              Scan via BCA, Mandiri, BRImo, BNI, GoPay, OVO, Dana, ShopeePay
            </span>
          </div>

          <!-- Quick Action Buttons -->
          <div class="row" style="margin-top: 14px; gap: 10px;">
            <button
              type="button"
              id="btn-download"
              class="btn"
              style="flex: 1; font-size: 13px; padding: 11px 16px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 8px;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              Unduh Gambar QR
            </button>
            <button
              type="button"
              id="btn-copy-string"
              class="btn btn--secondary"
              style="flex: 1; font-size: 13px; padding: 11px 16px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 8px;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
              Salin String QRIS
            </button>
          </div>

          <!-- Live Listening Pulse -->
          <div class="live-pulse-container">
            <span class="live-dot"></span>
            <span>Menunggu notifikasi pembayaran masuk...</span>
          </div>

          <!-- Cara Pembayaran -->
          <div class="instruction-box">
            <b style="color: var(--dp-color-ink); display: block; margin-bottom: 8px; font-size: 13px;">
              Petunjuk Pembayaran:
            </b>
            <ol style="margin: 0; padding-left: 20px; font-size: 12.5px; color: #475569; line-height: 1.6;">
              <li>Buka aplikasi m-Banking (BCA, BRImo, Livin' Mandiri, BNI Mobile) atau e-Wallet (ShopeePay, GoPay, OVO, DANA).</li>
              <li>Pilih menu <strong>Scan QRIS</strong> dan arahkan kamera ke kode QR di atas (nominal akan terisi otomatis).</li>
              <li>Pastikan nominal transfer persis sesuai angka yang tertera di atas (termasuk kode unik verifikasi).</li>
              <li>Selesaikan pembayaran. Sistem akan mendeteksi transaksi secara real-time dan mengalihkan Anda ke halaman tiket.</li>
            </ol>
          </div>

          <!-- Simulation / Fast Verification Bar -->
          <div style="margin-top: 16px; padding: 14px 18px; border-radius: 14px; background: #f0fdf4; border: 1px solid #bbf7d0; text-align: center;">
            <p style="font-size: 12.5px; color: #166534; margin: 0 0 10px; font-weight: 500;">
              💡 <strong>Sedang menguji pembayaran?</strong> Klik tombol di bawah untuk menyimulasikan uang masuk dan memicu status LUNAS secara instan:
            </p>
            <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
              <button
                type="button"
                id="btn-simulate-pay"
                class="btn"
                style="background: #10b981; border-color: #10b981; color: #fff; font-size: 13px; padding: 10px 18px; font-weight: 700; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);"
              >
                ⚡ Simulasi Bayar & Lunaskan Sekarang
              </button>
              <button
                type="button"
                id="btn-check-status"
                class="btn btn--secondary"
                style="font-size: 13px; padding: 10px 18px; font-weight: 600;"
              >
                Segarkan Status ⟳
              </button>
            </div>
          </div>

          <!-- Technical Inspector Accordion / Box (EMVCo Breakdown) -->
          <details class="tech-inspector-details">
            <summary class="tech-summary">
              <span>Spesifikasi EMVCo & Tag TLV</span>
              <span class="font-mono text-muted" style="font-size: 11px;">CRC16: <strong id="display-crc">{merchantInfo.crc}</strong></span>
            </summary>
            <div style="padding-top: 14px;">
              <div class="grid-tlv">
                <div class="tlv-item">
                  <span class="tlv-tag">Tag 01: Initiation</span>
                  <span id="tag-01-preview" class="tlv-val" style="color: #059669;">010212</span>
                  <span class="tlv-desc">Dinamis (semula 010211)</span>
                </div>
                <div class="tlv-item">
                  <span class="tlv-tag">Tag 54: Amount</span>
                  <span id="tag-54-preview" class="tlv-val" style="color: #2563eb;">5406...</span>
                  <span class="tlv-desc">Tag + Panjang + Nominal</span>
                </div>
                <div class="tlv-item">
                  <span class="tlv-tag">Tag 63: Checksum</span>
                  <span id="tag-63-preview" class="tlv-val" style="color: #d97706;">6304...</span>
                  <span class="tlv-desc">CRC16-CCITT (0x1021)</span>
                </div>
              </div>

              <div style="margin-top: 12px;">
                <span class="meta" style="font-size: 11px; display: block; margin-bottom: 4px; font-weight: 600;">
                  Raw Dynamic String EMVCo:
                </span>
                <textarea
                  id="raw-qris-display"
                  readonly
                  rows="2"
                  class="raw-qris-textarea"
                ></textarea>
              </div>
            </div>
          </details>

          <div id="pay-msg" class="alert alert--bad" role="alert" hidden style="margin-top: 14px;"></div>
        </div>
      </div>
    )}
  </section>

  <style>
    /* Status & Countdown Bar */
    .status-bar-card {
      background: #f8fafc;
      border: 1px solid var(--dp-color-rule);
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 20px;
    }
    .badge-waiting {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      background: #fef3c7;
      color: #b45309;
      border: 1px solid #fde68a;
    }
    .badge-paid {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #bbf7d0;
    }
    .badge-expired {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 700;
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .dot-ping {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
      animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .countdown-display {
      font-family: var(--font-display), monospace;
      font-size: 14px;
      font-weight: 800;
      color: #b45309;
      margin-top: 2px;
    }
    .countdown-danger {
      color: #dc2626 !important;
      animation: pulse 1s infinite;
    }

    /* Merchant styling */
    .merchant-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #2563eb;
      background: #eff6ff;
      border: 1px solid #dbeafe;
      padding: 3px 10px;
      border-radius: 999px;
    }

    /* QR Preview Box */
    .qr-preview-wrapper {
      display: flex;
      justify-content: center;
      margin: 14px 0;
    }
    .qr-box {
      background: #ffffff;
      padding: 16px;
      border-radius: 20px;
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.08);
      border: 1px solid #e2e8f0;
      position: relative;
      display: inline-block;
      min-width: 280px;
      min-height: 280px;
    }
    .qr-image {
      width: 250px;
      height: 250px;
      display: block;
      margin: 0 auto;
      border-radius: 12px;
      transition: transform 0.2s ease;
    }
    .qr-image:hover {
      transform: scale(1.02);
    }
    [hidden] {
      display: none !important;
    }
    .expired-overlay {
      display: none;
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(4px);
      border-radius: 20px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      text-align: center;
      z-index: 10;
    }
    .expired-overlay.is-active {
      display: flex !important;
    }
    .expired-icon-box {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.2);
      border: 2px solid #ef4444;
      color: #ef4444;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }

    /* Locked Amount Box */
    .locked-amount-card {
      background: #ffffff;
      border: 2px dashed #2563eb;
      border-radius: 16px;
      padding: 16px 20px;
      text-align: center;
      margin: 8px 0;
    }
    .locked-amount-label {
      font-size: 11.5px;
      font-weight: 750;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      display: block;
    }
    .locked-amount-value {
      font-size: clamp(1.6rem, 4vw, 2.1rem);
      font-weight: 900;
      color: #0f172a;
    }
    .copy-pill-btn {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s;
    }
    .copy-pill-btn:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    /* Live Pulse */
    .live-pulse-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 12.5px;
      color: #0284c7;
      font-weight: 600;
      margin: 16px 0 10px;
    }
    .live-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #0284c7;
      animation: pulse 1.5s infinite;
    }

    /* Instructions */
    .instruction-box {
      background: #f8fafc;
      border: 1px solid var(--dp-color-rule);
      border-radius: 14px;
      padding: 16px 18px;
      margin-top: 10px;
    }

    /* Technical Inspector */
    .tech-inspector-details {
      margin-top: 14px;
      border: 1px solid var(--dp-color-rule);
      border-radius: 14px;
      padding: 12px 16px;
      background: #f8fafc;
      font-size: 12px;
    }
    .tech-summary {
      cursor: pointer;
      font-weight: 700;
      color: var(--dp-color-ink);
      display: flex;
      align-items: center;
      justify-content: space-between;
      user-select: none;
    }
    .grid-tlv {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .tlv-item {
      background: #ffffff;
      border: 1px solid var(--dp-color-rule);
      padding: 10px 12px;
      border-radius: 10px;
    }
    .tlv-tag {
      font-size: 10.5px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      display: block;
    }
    .tlv-val {
      font-family: monospace;
      font-weight: 700;
      font-size: 13px;
      display: block;
      margin: 2px 0;
    }
    .tlv-desc {
      font-size: 10px;
      color: #94a3b8;
      display: block;
    }
    .raw-qris-textarea {
      width: 100%;
      background: #ffffff;
      border: 1px solid var(--dp-color-rule);
      border-radius: 8px;
      padding: 8px 10px;
      font-family: monospace;
      font-size: 11px;
      color: #334155;
      resize: none;
      outline: none;
    }

    /* Modal Backdrop & Card */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(8px);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-backdrop.is-active {
      display: flex !important;
      animation: fadeIn 0.25s ease-out;
    }
    .modal-card {
      position: relative;
      background: #ffffff;
      border-radius: 28px;
      max-width: 480px;
      width: 100%;
      padding: 32px 28px;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.3);
      border: 2px solid #10b981;
      overflow: hidden;
      animation: zoomIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-glow {
      position: absolute;
      top: -60px;
      right: -60px;
      width: 180px;
      height: 180px;
      background: rgba(16, 185, 129, 0.15);
      border-radius: 50%;
      filter: blur(35px);
      pointer-events: none;
    }
    .modal-icon-badge {
      width: 72px;
      height: 72px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: rgba(16, 185, 129, 0.12);
      border: 2px solid #10b981;
      color: #10b981;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 30px rgba(16, 185, 129, 0.35);
    }
    .modal-icon-badge svg {
      width: 36px;
      height: 36px;
    }
    .modal-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(16, 185, 129, 0.1);
      color: #059669;
      border: 1px solid rgba(16, 185, 129, 0.25);
    }
    .receipt-box {
      margin-top: 20px;
      background: #f8fafc;
      border: 1px solid var(--dp-color-rule);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-size: 12.5px;
    }
    .receipt-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 8px;
      border-bottom: 1px solid #e2e8f0;
    }
    .receipt-val {
      font-size: 13px;
    }
    .receipt-badge {
      background: #dcfce7;
      color: #166534;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 11px;
    }

    /* Keyframes */
    @keyframes pulse {
      0% { opacity: 0.3; transform: scale(0.92); }
      50% { opacity: 1; transform: scale(1.08); }
      100% { opacity: 0.3; transform: scale(0.92); }
    }
    @keyframes ping {
      75%, 100% {
        transform: scale(2.2);
        opacity: 0;
      }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes zoomIn {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }
    .spinner-dot {
      width: 32px;
      height: 32px;
      margin: 0 auto;
      border: 3px solid #cbd5e1;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

