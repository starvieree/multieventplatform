---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import StateBox from '../../../components/StateBox.astro';
import { fmtDate, rupiah } from '../../../lib/utils/format';
import { snapScriptUrl } from '../../../lib/utils/midtrans';

const sb = Astro.locals.supabase;
const { data: r } = await sb
  .from('registrations')
  .select('id,registration_code,registration_status,total_amount,quantity,event:events(title,slug),ticket:ticket_categories(name),reservations:quota_reservations(status,expires_at)')
  .eq('id', Astro.params.id!)
  .maybeSingle();

if (!r) return Astro.rewrite('/404');
if (r.registration_status === 'draft') return Astro.redirect(`/registration/${r.id}/form`);
if (r.registration_status !== 'awaiting_payment') return Astro.redirect(`/registration/${r.id}/status`);

const res = (r as any).reservations?.find((x: any) => x.status === 'reserved' && +new Date(x.expires_at) > Date.now());
const ev = (r as any).event;
---

<PublicLayout title="Pembayaran Tiket" noindex>
  <section class="wrap" style="max-width: 640px; padding: 40px 0 80px;">
    {!res ? (
      <div class="card" style="padding: 40px 24px; text-align: center; border-radius: 24px; box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.1);">
        <div style="font-size: 3rem; margin-bottom: 12px;">⏳</div>
        <h1 style="font-size: 1.8rem; font-weight: 750; margin-bottom: 10px;">Waktu Pembayaran Telah Berakhir</h1>
        <p class="muted" style="max-width: 460px; margin: 0 auto 24px; line-height: 1.6;">
          Batas waktu reservasi tiket Anda telah berakhir dan kuota telah dilepas kembali ke publik. Anda dapat mendaftar ulang bila tiket masih tersedia.
        </p>
        <div class="row" style="justify-content: center; gap: 12px;">
          {ev?.slug && <a class="btn" href={`/events/${ev.slug}#daftar`}>Daftar Ulang Sekarang</a>}
          <a class="btn btn--secondary" href={`/registration/${r.id}/status`}>Cek Status Tiket</a>
        </div>
      </div>
    ) : (
      <div>
        <div style="margin-bottom: 24px;">
          <span class="hero__badge" style="margin-bottom: 10px; font-size: 11px;">
            Langkah Terakhir · Konfirmasi Pembayaran
          </span>
          <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0;">Selesaikan Pembayaran</h1>
          <p class="muted small" style="margin-top: 6px;">
            Tiket Anda telah diamankan sementara. Segera lakukan pembayaran sebelum batas waktu berakhir.
          </p>
        </div>

        <!-- 30-Minute Reservation Timer Banner -->
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 16px; padding: 14px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 8px; color: #92400e; font-weight: 600; font-size: 13.5px;">
            <span>⏳</span>
            <span>Batas Waktu Pembayaran:</span>
          </div>
          <b style="color: #b45309; font-size: 14px; font-family: var(--font-display);">
            {fmtDate(res.expires_at, true)} WIB
          </b>
        </div>

        <div
          class="card stack"
          id="pay"
          data-id={r.id}
          data-client-key={import.meta.env.MIDTRANS_CLIENT_KEY}
          data-snap={snapScriptUrl()}
          style="padding: 28px; border-radius: 20px; box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.08);"
        >
          <div style="border-bottom: 1px solid var(--dp-color-rule); padding-bottom: 16px; margin-bottom: 8px;">
            <span class="meta" style="font-size: 12px; font-weight: 600; color: var(--dp-color-accent); text-transform: uppercase;">
              Rincian Pemesanan
            </span>
            <h2 style="font-size: 1.25rem; margin: 4px 0 0; line-height: 1.3;">{ev.title}</h2>
          </div>

          <dl class="kv" style="gap: 12px 20px; font-size: 14px;">
            <dt>Kategori Tiket</dt>
            <dd><b>{(r as any).ticket.name}</b> × {r.quantity} tiket</dd>
            <dt>Kode Booking</dt>
            <dd style="font-family: monospace; font-weight: 600;">{r.registration_code}</dd>
            <dt>Total Pembayaran</dt>
            <dd>
              <b style="font-size: 1.3rem; color: var(--dp-color-accent); font-family: var(--font-display);">
                {rupiah(r.total_amount)}
              </b>
            </dd>
          </dl>

          <div id="pay-msg" class="alert alert--bad" role="alert" hidden style="margin-top: 14px;"></div>

          <div style="margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--dp-color-rule);">
            <button class="btn" id="pay-btn" type="button" style="width: 100%; font-size: 16px; padding: 13px; font-weight: 700;">
              Bayar Sekarang dengan Midtrans →
            </button>
          </div>

          <div style="display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; font-size: 12px; color: var(--dp-color-ink-secondary); line-height: 1.45;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Mendukung pembayaran aman via QRIS, GoPay, ShopeePay, Virtual Account BCA/Mandiri/BRI/BNI, dan Kartu Kredit. Status tiket langsung terbit setelah pembayaran terkonfirmasi.</span>
          </div>
        </div>
      </div>
    )}
  </section>
  <script>import '../../../scripts/payment.ts';</script>
</PublicLayout>
