---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import FormField from '../../../components/FormField.astro';
import StateBox from '../../../components/StateBox.astro';
import { fmtDate, rupiah } from '../../../lib/utils/format';

const sb = Astro.locals.supabase;
const { data: r } = await sb
  .from('registrations')
  .select('id,registration_status,total_amount,quantity,event_id,event:events(title,slug),ticket:ticket_categories(name),reservations:quota_reservations(status,expires_at)')
  .eq('id', Astro.params.id!)
  .maybeSingle();

if (!r) return Astro.rewrite('/404');
if (!['draft', 'awaiting_payment'].includes(r.registration_status)) return Astro.redirect(`/registration/${r.id}/status`);

const res = (r as any).reservations?.find((x: any) => x.status === 'reserved' && +new Date(x.expires_at) > Date.now());
const [{ data: fields }, { data: answers }] = await Promise.all([
  sb.from('event_form_fields').select('*').eq('event_id', r.event_id).eq('is_active', true).order('sort_order'),
  sb.from('registration_answers').select('field_key,answer').eq('registration_id', r.id),
]);

const prev = Object.fromEntries((answers ?? []).map((a) => [a.field_key, a.answer]));
const ev = (r as any).event;
---

<PublicLayout title="Formulir Pendaftaran Event" noindex>
  <section class="wrap" style="max-width: 680px; padding: 40px 0 80px;">
    {!res ? (
      <StateBox
        kind="error"
        title="Waktu reservasi telah berakhir"
        text="Kuota tiket Anda telah dilepas kembali ke publik. Silakan lakukan pendaftaran ulang selama kuota masih tersedia."
        href={`/events/${ev.slug}#daftar`}
        action="Daftar Ulang"
      />
    ) : (
      <div>
        <div style="margin-bottom: 24px;">
          <span class="hero__badge" style="margin-bottom: 10px; font-size: 11px;">
            Langkah 2 dari 3 · Pengisian Formulir
          </span>
          <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0 0 6px;">Lengkapi Data Peserta</h1>
          <p class="muted small" style="margin: 0;">
            Event: <b>{ev.title}</b> · {(r as any).ticket.name} × {r.quantity} tiket · {rupiah(r.total_amount)}
          </p>
        </div>

        <!-- Timer Alert -->
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 16px; padding: 14px 18px; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 8px; color: #92400e; font-size: 13.5px; font-weight: 500;">
            <span>⏱️</span>
            <span>Selesaikan sebelum <b>{fmtDate(res.expires_at, true)} WIB</b></span>
          </div>
          <div style="font-weight: 700; color: #b45309; font-size: 15px; font-family: var(--font-display);">
            Sisa Waktu: <span id="countdown" data-expires={res.expires_at}>--:--</span>
          </div>
        </div>

        <form class="form card" id="reg-form" data-id={r.id} style="padding: 32px; border-radius: 20px; box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.08);">
          {(fields ?? []).map((f) => (
            <FormField
              name={f.field_key}
              label={f.label}
              type={
                f.field_type === 'tel' ||
                f.field_type === 'email' ||
                f.field_type === 'number' ||
                f.field_type === 'date' ||
                f.field_type === 'checkbox' ||
                f.field_type === 'select' ||
                f.field_type === 'textarea'
                  ? f.field_type
                  : 'text'
              }
              value={prev[f.field_key] ?? ''}
              required={f.is_required}
              options={f.options ?? []}
            />
          ))}

          {(fields ?? []).length === 0 && (
            <div style="text-align: center; padding: 20px 0;">
              <p class="muted" style="margin: 0;">
                Event ini tidak memerlukan formulir tambahan. Silakan klik tombol di bawah untuk melanjutkan.
              </p>
            </div>
          )}

          <div id="reg-msg" class="alert alert--bad" role="alert" hidden style="margin-top: 14px;"></div>

          <div style="margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--dp-color-rule);">
            <button class="btn" type="submit" id="reg-btn" style="width: 100%; font-size: 16px; padding: 13px; font-weight: 700;">
              {r.total_amount > 0 ? 'Simpan & Lanjut ke Pembayaran →' : 'Selesaikan Pendaftaran Gratis →'}
            </button>
          </div>
        </form>
      </div>
    )}
  </section>
  <script>import '../../../scripts/reg-form.ts';</script>
</PublicLayout>
