---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Badge from '../../../components/Badge.astro';
import Timeline from '../../../components/Timeline.astro';
import { rupiah } from '../../../lib/utils/format';
import { nextAction, timeline } from '../../../lib/utils/registration';
const { data: r } = await Astro.locals.supabase.from('registrations').select('id,registration_code,registration_status,payment_status,total_amount,event:events(title),tickets(id)').eq('id', Astro.params.id!).maybeSingle();
if (!r) return Astro.rewrite('/404');
const a = nextAction(r as any), hasTicket = ((r as any).tickets ?? []).length > 0;
const msg: Record<string, string> = { confirmed: 'Pendaftaran Anda terkonfirmasi. Tiket sudah terbit.', awaiting_payment: r.payment_status === 'pending' ? 'Menunggu konfirmasi pembayaran. Ini bisa memakan waktu beberapa saat setelah Anda membayar.' : 'Pembayaran belum selesai.', draft: 'Formulir belum dilengkapi.', cancelled: 'Pendaftaran dibatalkan.', expired: 'Waktu reservasi berakhir dan kuota dilepas.' };
const waiting = r.registration_status === 'awaiting_payment';
---
<PublicLayout title="Status pendaftaran" noindex>
  <section class="section"><div class="wrap" style="max-width:680px"><h1 style="font-size:2.2rem">Status pendaftaran</h1>
    <div class="card card--pad stack" id="status" data-id={r.id} data-state={r.registration_status} data-pay={r.payment_status}>
      <div class="row between"><b>{(r as any).event?.title}</b><div class="row"><Badge status={r.registration_status} /><Badge status={r.payment_status} /></div></div>
      <p aria-live="polite" id="s-msg" style="margin:0">{msg[r.registration_status]}{r.registration_status === 'cancelled' && r.payment_status === 'paid' ? ' Pembayaran Anda terdeteksi; tim kami akan menghubungi untuk proses pengembalian dana.' : ''}</p>
      <dl class="kv"><dt>Kode</dt><dd>{r.registration_code}</dd><dt>Total</dt><dd>{rupiah(r.total_amount)}</dd></dl>
      <Timeline steps={timeline(r as any, hasTicket)} />
      <div class="row">{a && <a class="btn" href={a.href}>{a.label}</a>}{hasTicket && <a class="btn" href="/dashboard/tickets">Lihat tiket</a>}{waiting && <button class="btn btn--secondary" id="refresh" type="button">Segarkan status</button>}<a class="btn btn--secondary" href={`/dashboard/registrations/${r.id}`}>Detail pendaftaran</a></div>
    </div></div></section>
  <script>import '../../../scripts/status.ts';</script>
</PublicLayout>
