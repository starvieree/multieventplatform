---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import Badge from '../../../components/Badge.astro';
import Timeline from '../../../components/Timeline.astro';
import { rupiah } from '../../../lib/utils/format';
import { nextAction, timeline } from '../../../lib/utils/registration';

const { data: r } = await Astro.locals.supabase
  .from('registrations')
  .select('id,registration_code,registration_status,payment_status,total_amount,event:events(title,slug),tickets(id)')
  .eq('id', Astro.params.id!)
  .maybeSingle();

if (!r) return Astro.rewrite('/404');

const a = nextAction(r as any);
const hasTicket = ((r as any).tickets ?? []).length > 0;
const msg: Record<string, string> = {
  confirmed: 'Pendaftaran Anda berhasil terkonfirmasi! E-Ticket resmi telah diterbitkan.',
  awaiting_payment: r.payment_status === 'pending'
    ? 'Menunggu konfirmasi pembayaran dari payment gateway. Status akan diperbarui secara otomatis.'
    : 'Pembayaran belum diselesaikan.',
  draft: 'Formulir data peserta belum dilengkapi.',
  cancelled: 'Pendaftaran ini telah dibatalkan.',
  expired: 'Waktu reservasi telah berakhir dan kuota tiket telah dilepas. Anda dapat mendaftar ulang jika kuota masih ada.',
};

const waiting = r.registration_status === 'awaiting_payment';
const isExpiredOrCancelled = ['expired', 'cancelled'].includes(r.registration_status);
---

<PublicLayout title="Status Pendaftaran" noindex>
  <section class="wrap" style="max-width: 680px; padding: 40px 0 80px;">
    <div style="margin-bottom: 24px;">
      <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0 0 6px;">Status Pendaftaran</h1>
      <p class="muted small" style="margin: 0;">Pantau proses pemesanan dan penerbitan tiket Anda secara transparan.</p>
    </div>

    <div
      class="card stack"
      id="status"
      data-id={r.id}
      data-state={r.registration_status}
      data-pay={r.payment_status}
      style="padding: 32px; border-radius: 20px; box-shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.08);"
    >
      <div class="row between" style="border-bottom: 1px solid var(--dp-color-rule); padding-bottom: 16px;">
        <div>
          <span class="meta" style="font-size: 11px; font-weight: 600; color: var(--dp-color-accent); text-transform: uppercase;">
            Event
          </span>
          <h2 style="font-size: 1.25rem; margin: 2px 0 0; line-height: 1.3;">{(r as any).event?.title}</h2>
        </div>
        <div class="row" style="gap: 8px;">
          <Badge status={r.registration_status} />
          <Badge status={r.payment_status} />
        </div>
      </div>

      <div style="background: var(--dp-color-ground-muted); border-radius: 14px; padding: 14px 18px; border: 1px solid var(--dp-color-rule);">
        <p aria-live="polite" id="s-msg" style="margin: 0; font-size: 14px; line-height: 1.5; color: var(--dp-color-ink);">
          {msg[r.registration_status]}
          {r.registration_status === 'cancelled' && r.payment_status === 'paid' ? ' Pembayaran Anda terdeteksi; tim kami akan segera menghubungi untuk proses pengembalian dana.' : ''}
        </p>
      </div>

      <dl class="kv" style="gap: 10px 20px; font-size: 14px; padding: 6px 0;">
        <dt>Kode Pendaftaran</dt>
        <dd style="font-family: monospace; font-weight: 600;">{r.registration_code}</dd>
        <dt>Total Pembayaran</dt>
        <dd><b>{rupiah(r.total_amount)}</b></dd>
      </dl>

      <div style="padding: 12px 0; border-top: 1px solid var(--dp-color-rule); border-bottom: 1px solid var(--dp-color-rule);">
        <h3 style="font-size: 1rem; margin-bottom: 16px;">Riwayat Alur Registrasi</h3>
        <Timeline steps={timeline(r as any, hasTicket)} />
      </div>

      <div class="row" style="gap: 10px; margin-top: 8px;">
        {isExpiredOrCancelled && (r as any).event?.slug && (
          <a class="btn" href={`/events/${(r as any).event.slug}#daftar`}>Daftar Ulang</a>
        )}
        {a && <a class="btn" href={a.href}>{a.label}</a>}
        {hasTicket && <a class="btn" href="/tiket-saya">Buka Tiket Saya →</a>}
        {waiting && (
          <button class="btn btn--secondary" id="refresh" type="button">Segarkan Status ⟳</button>
        )}
        <a class="btn btn--secondary" href={`/pesanan/${r.id}`}>Rincian Pesanan</a>
      </div>
    </div>
  </section>
  <script>import '../../../scripts/status.ts';</script>
</PublicLayout>
