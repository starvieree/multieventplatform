---
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { ERROR_TEXT } from "../../../lib/utils/status";
const sb = Astro.locals.supabase;
const { data: q } = await sb
  .from("queue_requests")
  .select("id,status,error_code,event_id")
  .eq("id", Astro.params.id!)
  .maybeSingle();
if (!q) return Astro.rewrite("/404");
if (q.status === "accepted") {
  const { data: r } = await sb
    .from("registrations")
    .select("id")
    .eq("queue_request_id", q.id)
    .maybeSingle();
  if (r) return Astro.redirect(`/registration/${r.id}/form`);
}
const { data: ev } = await sb
  .from("events")
  .select("title,slug")
  .eq("id", q.event_id)
  .maybeSingle();
const failed = ["rejected", "failed", "expired"].includes(q.status);
---

<PublicLayout title="Ruang Tunggu Antrean Tiket" noindex>
  <section class="wrap" style="max-width: 580px; padding: 48px 0 80px;">
    <div
      class="card"
      id="queue"
      data-id={q.id}
      data-state={q.status}
      style="padding: 36px 32px; border-radius: 24px; text-align: center; box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.12);"
    >
      <!-- Pulsing radar animation -->
      <div
        style="position: relative; width: 72px; height: 72px; margin: 0 auto 20px; display: grid; place-items: center;"
      >
        <div
          style="position: absolute; inset: 0; border-radius: 50%; background: #eff6ff; border: 2px solid #bfdbfe; animation: queue-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;"
        >
        </div>
        <div
          style="width: 52px; height: 52px; border-radius: 50%; background: var(--dp-color-accent); color: #fff; display: grid; place-items: center; position: relative; z-index: 2; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);"
        >
          {
            failed ? (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            ) : (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
              </svg>
            )
          }
        </div>
      </div>

      <span class="hero__badge" style="margin-bottom: 12px; font-size: 11px;">
        {failed ? "Status Antrean" : "⚡ Sistem Antrean War Tiket"}
      </span>

      {
        ev?.title && (
          <p
            class="meta"
            style="font-size: 13px; font-weight: 600; color: var(--dp-color-accent); margin-bottom: 6px;"
          >
            {ev.title}
          </p>
        )
      }

      <h1
        style="font-size: clamp(1.4rem, 3vw, 1.8rem); line-height: 1.25; margin-bottom: 12px;"
        id="q-title"
      >
        {
          failed
            ? "Pendaftaran Belum Berhasil"
            : "Sedang Mengamankan Kuota Anda"
        }
      </h1>

      <div
        id="q-body"
        aria-live="polite"
        class="stack"
        style="margin-bottom: 20px;"
      >
        {
          failed ? (
            <p style="color: #b42318; font-weight: 500;">
              {(q.error_code && ERROR_TEXT[q.error_code]) ??
                "Permintaan tidak dapat diproses atau kuota tiket telah habis."}
            </p>
          ) : (
            <p
              class="muted"
              style="font-size: 14px; line-height: 1.6; max-width: 44ch; margin: 0 auto;"
            >
              Permintaan tiket Anda masuk dalam antrean terstruktur dan sedang
              diverifikasi secara berurutan. <b>Mohon tetap di halaman ini</b>{" "}
              dan jangan menutup atau merefresh browser.
            </p>
          )
        }
      </div>

      {
        !failed && (
          <div style="background: var(--dp-color-ground-muted); border: 1px solid var(--dp-color-rule); border-radius: 14px; padding: 14px 18px; margin-bottom: 24px; text-align: left; display: flex; align-items: center; gap: 12px;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; animation: pulse 1.5s infinite; flex-shrink: 0;" />
            <span
              class="meta"
              style="color: var(--dp-color-ink); font-weight: 500; font-size: 13px;"
              id="q-wait"
            >
              Memeriksa ketersediaan kuota ke server…
            </span>
          </div>
        )
      }

      <div
        class="row"
        id="q-actions"
        style="justify-content: center; gap: 10px;"
      >
        {
          failed ? (
            <>
              <a class="btn" href={ev ? `/events/${ev.slug}` : "/events"}>
                Kembali ke Event
              </a>
              <a class="btn btn--secondary" href="/events">
                Lihat Event Lain
              </a>
            </>
          ) : (
            <span
              class="meta"
              style="font-size: 12px; color: var(--dp-color-ink-secondary);"
            >
              Layar akan berpindah secara otomatis ke formulir pemesanan.
            </span>
          )
        }
      </div>
    </div>
  </section>

  <style>
    @keyframes queue-ping {
      75%,
      100% {
        transform: scale(1.6);
        opacity: 0;
      }
    }
    @keyframes pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.4;
      }
    }
  </style>

  <script>
    import "../../../scripts/queue.ts";
  </script>
</PublicLayout>
