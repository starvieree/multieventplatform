---
import PublicLayout from '../layouts/PublicLayout.astro';
import FormField from '../components/FormField.astro';
import Alert from '../components/Alert.astro';
if (!Astro.locals.user) return Astro.redirect('/forgot-password?error=expired');
const err = { weak: 'Kata sandi minimal 10 karakter.', mismatch: 'Konfirmasi kata sandi tidak sama.', failed: 'Kata sandi belum dapat diubah. Coba lagi.' }[Astro.url.searchParams.get('error') ?? ''];
---
<PublicLayout title="Atur ulang kata sandi" noindex><section class="auth wrap"><div class="card"><h1 style="font-size:2rem">Kata sandi baru</h1>{err && <Alert tone="bad">{err}</Alert>}
  <form class="form" method="post" action="/api/auth/reset" style="margin-top:16px"><FormField name="password" type="password" label="Kata sandi baru" required autocomplete="new-password" hint="Minimal 10 karakter." /><FormField name="confirm" type="password" label="Ulangi kata sandi" required autocomplete="new-password" /><button class="btn" type="submit">Simpan kata sandi</button></form></div></section></PublicLayout>
