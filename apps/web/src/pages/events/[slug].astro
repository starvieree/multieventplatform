---
import PublicLayout from "../../layouts/PublicLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Badge from "../../components/Badge.astro";
import EventCard from "../../components/EventCard.astro";
import { fmtDate, mediaUrl, rupiah } from "../../lib/utils/format";
const { slug } = Astro.params;
const sb = Astro.locals.supabase;
const { data: ev } = await sb
  .from("events")
  .select("*, category:event_categories(name,slug)")
  .eq("slug", slug!)
  .maybeSingle();
if (!ev) return Astro.rewrite("/404");

const user = Astro.locals.user;
let userRegs: any[] = [];
if (user) {
  const { data: myRegs } = await sb
    .from("registrations")
    .select(
      "id, ticket_category_id, quantity, registration_status, payment_status, ticket:ticket_categories(name), reservations:quota_reservations(status,expires_at)",
    )
    .eq("event_id", ev.id)
    .eq("user_id", user.id)
    .in("registration_status", ["draft", "awaiting_payment", "confirmed"]);
  userRegs = myRegs ?? [];
}

const [
  { data: tickets },
  { data: avail },
  { data: listing },
  { data: related },
] = await Promise.all([
  sb
    .from("ticket_categories")
    .select("*")
    .eq("event_id", ev.id)
    .eq("is_active", true)
    .order("price"),
  sb
    .from("ticket_availability")
    .select("ticket_category_id,available")
    .eq("event_id", ev.id),
  sb.from("event_listing").select("available").eq("id", ev.id).maybeSingle(),
  sb
    .from("event_listing")
    .select("*")
    .eq("category_slug", ev.category?.slug ?? "")
    .neq("id", ev.id)
    .eq("status", "published")
    .limit(3),
]);
const left = new Map(
  (avail ?? []).map((a) => [a.ticket_category_id, a.available as number]),
);
const now = Date.now();
const windowOpen =
  ev.status === "published" &&
  now >= +new Date(ev.registration_opens_at) &&
  now <= +new Date(ev.registration_closes_at);
const sellable = (tickets ?? []).filter(
  (t) =>
    (!t.sales_start_at || now >= +new Date(t.sales_start_at)) &&
    (!t.sales_end_at || now <= +new Date(t.sales_end_at)),
);

// Hanya hitung pendaftaran yang benar-benar aktif (confirmed, atau draft/awaiting_payment yang reservasinya belum lewat waktu)
const activeRegs = userRegs.filter((r: any) => {
  if (r.registration_status === "confirmed") return true;
  return (r.reservations ?? []).some(
    (res: any) =>
      res.status === "reserved" && new Date(res.expires_at).getTime() > now,
  );
});
const hasExpiredPriorReg = userRegs.length > 0 && activeRegs.length === 0;

const activeCategoryIds = new Set(
  activeRegs.map((r: any) => r.ticket_category_id),
);
const hasActiveReg = activeRegs.length > 0;
const totalUserTickets = activeRegs.reduce(
  (sum: number, r: any) => sum + (r.quantity ?? 1),
  0,
);
const userReachedLimit = !!user && totalUserTickets >= ev.max_per_user;
const isSingleCategoryRestricted = !ev.allow_multiple_categories;

const registeredCategoryNames = activeRegs
  .map((r: any) => r.ticket?.name)
  .filter(Boolean);
const primaryRegisteredName = registeredCategoryNames[0] ?? "kategori lain";

const canRegister =
  windowOpen &&
  !userReachedLimit &&
  sellable.some((t) => {
    const a = left.get(t.id) ?? 0;
    if (a <= 0) return false;
    if (
      user &&
      isSingleCategoryRestricted &&
      hasActiveReg &&
      !activeCategoryIds.has(t.id)
    ) {
      return false;
    }
    return true;
  });

const reason =
  ev.status !== "published"
    ? "Pendaftaran untuk event ini sudah ditutup."
    : now < +new Date(ev.registration_opens_at)
      ? `Pendaftaran dibuka ${fmtDate(ev.registration_opens_at, true)}.`
      : now > +new Date(ev.registration_closes_at)
        ? "Periode pendaftaran sudah berakhir."
        : userReachedLimit
          ? `Anda sudah mencapai batas maksimum pendaftaran (${ev.max_per_user} tiket) untuk akun ini.`
          : isSingleCategoryRestricted && hasActiveReg
            ? `Event ini membatasi 1 kategori tiket per akun. Anda sudah terdaftar di kategori ${primaryRegisteredName}.`
            : "Kuota sudah penuh.";

const poster = mediaUrl(ev.poster_path ?? ev.banner_path);
const faq = (Array.isArray(ev.faq) ? ev.faq : []) as {
  q?: string;
  a?: string;
  question?: string;
  answer?: string;
}[];
const next = encodeURIComponent(`/events/${ev.slug}#daftar`);

const getTicketMeta = (t: any) => {
  const a = left.get(t.id) ?? 0;
  const isRegistered = activeCategoryIds.has(t.id);
  const isLockedAnother =
    !!user && isSingleCategoryRestricted && hasActiveReg && !isRegistered;
  const isUserFull = userReachedLimit;

  let ok =
    windowOpen &&
    sellable.includes(t) &&
    a > 0 &&
    !isLockedAnother &&
    !isUserFull;
  let status = "";
  if (isLockedAnother) {
    status = "Terkunci · Maks. 1 kategori per akun";
  } else if (isUserFull) {
    status = isRegistered
      ? "✓ Terdaftar (Batas kuota akun tercapai)"
      : "Batas kuota akun tercapai";
  } else if (isRegistered) {
    status = `✓ Terdaftar di kategori ini (${a} tersisa)`;
  } else if (!windowOpen) {
    status = "Pendaftaran ditutup";
  } else if (!sellable.includes(t)) {
    status = "Belum dijual";
  } else if (a <= 0) {
    status = "Habis";
  } else {
    status = `${a} tiket tersisa`;
  }

  const end = t.sales_end_at ? ` · sampai ${fmtDate(t.sales_end_at)}` : "";
  return { a, ok, isRegistered, isLockedAnother, text: `${status}${end}` };
};
const defaultTicketIndex = (tickets ?? []).findIndex(
  (x) => getTicketMeta(x).ok,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: ev.title,
  description: ev.summary ?? undefined,
  startDate: ev.start_at,
  endDate: ev.end_at,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode:
    ev.event_type === "online"
      ? "https://schema.org/OnlineEventAttendanceMode"
      : ev.event_type === "hybrid"
        ? "https://schema.org/MixedEventAttendanceMode"
        : "https://schema.org/OfflineEventAttendanceMode",
  location:
    ev.event_type === "online"
      ? {
          "@type": "VirtualLocation",
          url: new URL(`/events/${ev.slug}`, Astro.site).toString(),
        }
      : {
          "@type": "Place",
          name: ev.venue_name ?? undefined,
          address: ev.address ?? undefined,
        },
  image: poster ? [poster] : undefined,
  organizer: ev.organizer_name
    ? { "@type": "Organization", name: ev.organizer_name }
    : undefined,
  offers: sellable.map((t) => ({
    "@type": "Offer",
    name: t.name,
    price: t.price,
    priceCurrency: "IDR",
    availability:
      (left.get(t.id) ?? 0) > 0
        ? "https://schema.org/InStock"
        : "https://schema.org/SoldOut",
    url: new URL(`/events/${ev.slug}`, Astro.site).toString(),
  })),
};
---

<PublicLayout
  title={ev.meta_title || ev.title}
  description={ev.meta_description || ev.summary || undefined}
  image={mediaUrl(ev.og_image_path ?? ev.poster_path)}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumb
      items={[
        { label: "Beranda", href: "/" },
        { label: "Event", href: "/events" },
        { label: ev.title },
      ]}
    />
  </div>
  <section class="section" style="padding-top:20px">
    <div
      class="wrap grid"
      style="grid-template-columns:1.5fr 1fr;gap:36px;align-items:start"
      id="detail-grid"
    >
      <div class="stack" style="gap:24px">
        {
          poster && (
            <div
              class="event-card__img-wrap"
              style="border-radius:20px;overflow:hidden;box-shadow:0 12px 32px -10px rgba(15,23,42,0.12);aspect-ratio:16/9;"
            >
              <img
                class="event-card__img"
                style="filter:none;"
                src={poster}
                alt={ev.poster_alt || `Poster ${ev.title}`}
                width="960"
                height="540"
              />
              {ev.category?.name && (
                <span
                  class="event-card__badge-tag"
                  style="font-size:12px;padding:6px 14px;"
                >
                  {ev.category.name}
                </span>
              )}
              <span
                class="event-card__badge-format"
                style="font-size:12px;padding:6px 14px;"
              >
                {ev.event_type === "online"
                  ? "🟢 Online"
                  : `📍 ${ev.venue_name || "Offline"}`}
              </span>
            </div>
          )
        }

        <div class="stack" style="gap:12px">
          <div class="row between">
            <span
              class="badge badge--ok"
              style="font-size:12px;padding:5px 12px;"
              >{ev.category?.name ?? "Event"}</span
            >
            <Badge status={ev.status} />
          </div>

          <h1
            style="font-size:clamp(1.9rem,3.8vw,2.8rem);line-height:1.2;margin:0"
          >
            {ev.title}
          </h1>
          {
            ev.summary && (
              <p class="lead" style="font-size:1.1rem;margin:0">
                {ev.summary}
              </p>
            )
          }

          <div class="chips-bar" style="margin:8px 0 4px;padding:0;gap:8px;">
            <div class="chips-bar__item">
              <span class="chips-pill" style="font-size:13px;padding:6px 14px;">
                📅 {fmtDate(ev.start_at, true)} (WIB)
              </span>
            </div>
            <div class="chips-bar__item">
              <span class="chips-pill" style="font-size:13px;padding:6px 14px;">
                {
                  ev.event_type === "online"
                    ? "🌐 Webinar Online"
                    : `📍 ${ev.venue_name || "Venue Acara"}`
                }
              </span>
            </div>
            <div class="chips-bar__item">
              <span class="chips-pill" style="font-size:13px;padding:6px 14px;">
                👥 Tersedia {listing?.available ?? 0} / {ev.total_quota} Kuota
              </span>
            </div>
          </div>
        </div>

        <dl
          class="kv card card--pad"
          style="border-radius:18px;background:var(--dp-color-panel);border:1px solid var(--dp-color-rule);"
        >
          <dt>Waktu Pelaksanaan</dt>
          <dd>
            <b>{fmtDate(ev.start_at, true)}</b> – {fmtDate(ev.end_at, true)} WIB
          </dd>
          <dt>Lokasi Acara</dt>
          <dd>
            {
              ev.event_type === "online"
                ? "Diselenggarakan Secara Online"
                : [ev.venue_name, ev.address].filter(Boolean).join(", ") ||
                  "Segera diumumkan oleh panitia"
            }{
              ev.event_type !== "offline" && ev.online_url && (
                <>
                  {" "}
                  ·{" "}
                  <a
                    href={ev.online_url}
                    rel="noopener noreferrer"
                    target="_blank"
                    style="font-weight:600"
                  >
                    Buka tautan acara ↗
                  </a>
                </>
              )
            }
          </dd>
          <dt>Periode Pendaftaran</dt>
          <dd>
            {fmtDate(ev.registration_opens_at)} – {
              fmtDate(ev.registration_closes_at)
            }
          </dd>
          <dt>Penyelenggara</dt>
          <dd>{ev.organizer_name ?? "Platform Event Partner"}</dd>
          <dt>Sisa Kuota</dt>
          <dd>
            <b>{listing?.available ?? 0}</b> dari total {ev.total_quota} tiket
          </dd>
        </dl>
        {
          ev.description && (
            <>
              <>
                <h2 id="deskripsi">Tentang event</h2>
                <div class="prose" style="white-space:pre-line">
                  {ev.description}
                </div>
              </>
            </>
          )
        }
        {
          ev.requirements && (
            <>
              <>
                <h2>Persyaratan peserta</h2>
                <div class="prose" style="white-space:pre-line">
                  {ev.requirements}
                </div>
              </>
            </>
          )
        }
        {
          ev.event_type !== "online" && ev.address && (
            <>
              <>
                <h2>Lokasi</h2>
                <p>
                  {ev.venue_name}
                  <br />
                  {ev.address}
                </p>
                <a
                  class="btn btn--secondary btn--sm"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([ev.venue_name, ev.address].filter(Boolean).join(" "))}`}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  Buka di peta
                </a>
              </>
            </>
          )
        }
        {
          faq.length > 0 && (
            <>
              <>
                <h2>Pertanyaan umum</h2>
                <div>
                  {faq.map((f) => (
                    <details class="faq">
                      <summary>{f.q || f.question}</summary>
                      <div>{f.a || f.answer}</div>
                    </details>
                  ))}
                </div>
              </>
            </>
          )
        }
      </div>

      <aside
        class="card card--pad"
        id="daftar"
        style="position:sticky;top:88px"
        aria-labelledby="daftar-h"
      >
        <h2 id="daftar-h" style="font-size:1.4rem">Kategori tiket</h2>
        {
          (tickets ?? []).length === 0 ? (
            <p class="muted">Tiket belum tersedia.</p>
          ) : (
            <form
              id="register-form"
              data-event={ev.id}
              data-slug={ev.slug}
              data-max={ev.max_per_user}
              data-can={canRegister && !!Astro.locals.user ? "1" : "0"}
            >
              {hasExpiredPriorReg && (
                <div
                  class="card card--pad"
                  style="background:#fef3c7;border:1px solid #fde68a;padding:12px 14px;margin-bottom:14px;border-radius:var(--dp-radius-panel);font-size:0.875rem;color:#92400e"
                >
                  <div style="font-weight:600;margin-bottom:4px;display:flex;align-items:center;gap:6px">
                    <span>⏱️ Waktu Pembayaran Sebelumnya Telah Berakhir</span>
                  </div>
                  <p style="margin:0;line-height:1.4">
                    Reservasi tiket Anda sebelumnya telah kadaluarsa dan kuota
                    sudah dilepas kembali. Anda dapat memilih tiket dan
                    mendaftar ulang di bawah ini selama kuota masih tersedia.
                  </p>
                </div>
              )}
              {hasActiveReg && (
                <div
                  class="card card--pad"
                  style="background:var(--accent-tint,#e8f0fe);border:1px solid #bfdbfe;padding:12px 14px;margin-bottom:14px;border-radius:var(--dp-radius-panel);font-size:0.875rem"
                >
                  <div style="font-weight:600;color:var(--dp-color-accent);margin-bottom:4px;display:flex;align-items:center;gap:6px">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="12" y1="8" x2="12" y2="12" />
                      <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <span>Status Pendaftaran Anda</span>
                  </div>
                  <p style="margin:0 0 8px 0;color:var(--dp-color-ink);line-height:1.4">
                    {isSingleCategoryRestricted ? (
                      <>
                        Event ini membatasi{" "}
                        <strong>1 kategori tiket per akun</strong>. Anda saat
                        ini sudah terdaftar di kategori{" "}
                        <strong>{primaryRegisteredName}</strong>.
                      </>
                    ) : (
                      <>
                        Anda sudah terdaftar di kategori{" "}
                        <strong>{primaryRegisteredName}</strong>. Event ini
                        mengizinkan Anda mendaftar lebih dari 1 kategori selama
                        batas kuota akun mencukupi.
                      </>
                    )}
                  </p>
                  <a
                    href="/pesanan"
                    class="btn btn--secondary btn--sm"
                    style="font-size:0.8rem;padding:4px 10px;text-decoration:none"
                  >
                    Lihat detail pesanan &rarr;
                  </a>
                </div>
              )}
              <fieldset style="border:0;padding:0;margin:0" class="stack">
                <legend class="sr-only">Pilih kategori tiket</legend>
                {(tickets ?? []).map((t, i) => {
                  const meta = getTicketMeta(t);
                  return (
                    <label
                      class={`ticket ${meta.isLockedAnother ? "ticket--locked" : ""} ${meta.isRegistered ? "ticket--registered" : ""}`}
                      style={
                        meta.isLockedAnother
                          ? "opacity:0.65;background:var(--dp-color-ground-muted,#f3f4f6);cursor:not-allowed;"
                          : undefined
                      }
                    >
                      <div>
                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                          <b>{t.name}</b>
                          {meta.isLockedAnother && (
                            <span style="font-size:0.7rem;padding:1px 6px;border-radius:999px;background:#e5e7eb;color:#4b5563;font-weight:600">
                              Terkunci
                            </span>
                          )}
                          {meta.isRegistered && (
                            <span style="font-size:0.7rem;padding:1px 6px;border-radius:999px;background:#dcfce7;color:#166534;font-weight:600">
                              Terdaftar
                            </span>
                          )}
                        </div>
                        {t.description && (
                          <div class="meta">{t.description}</div>
                        )}
                        <div
                          class="meta"
                          style={
                            meta.isLockedAnother
                              ? "color:#dc2626;font-weight:500"
                              : meta.isRegistered
                                ? "color:#166534;font-weight:500"
                                : undefined
                          }
                        >
                          {meta.text}
                        </div>
                      </div>
                      <div style="text-align:right">
                        <span class="price">{rupiah(t.price)}</span>
                        <br />
                        <input
                          type="radio"
                          name="ticket"
                          value={t.id}
                          disabled={!meta.ok}
                          checked={meta.ok && i === defaultTicketIndex}
                          aria-label={`Pilih ${t.name}`}
                        />
                      </div>
                    </label>
                  );
                })}
              </fieldset>
              {canRegister && ev.max_per_user > 1 && (
                <div class="field" style="margin-top:14px">
                  <label for="qty">
                    Jumlah tiket (maks.{" "}
                    {Math.max(
                      1,
                      Math.min(
                        ev.max_per_user,
                        ev.max_per_user - totalUserTickets,
                      ),
                    )}
                    )
                  </label>
                  <input
                    class="input"
                    id="qty"
                    name="qty"
                    type="number"
                    min="1"
                    max={Math.max(
                      1,
                      Math.min(
                        ev.max_per_user,
                        ev.max_per_user - totalUserTickets,
                      ),
                    )}
                    value="1"
                  />
                </div>
              )}
              <div style="margin-top:16px" class="stack">
                {!canRegister ? (
                  <>
                    <div class="alert" role="status">
                      {reason}
                    </div>
                    {hasActiveReg && (
                      <a
                        class="btn btn--secondary"
                        style="width:100%;text-align:center"
                        href="/pesanan"
                      >
                        Lihat Pesanan Saya
                      </a>
                    )}
                  </>
                ) : Astro.locals.user ? (
                  <button
                    class="btn"
                    style="width:100%;font-size:1.05rem;padding:12px 20px;font-weight:700;"
                    type="submit"
                    id="register-btn"
                  >
                    Daftar Sekarang & Masuk Antrean →
                  </button>
                ) : (
                  <a
                    class="btn"
                    style="width:100%;font-size:1.05rem;padding:12px 20px;font-weight:700;"
                    href={`/login?next=${next}`}
                  >
                    Masuk untuk Mendaftar →
                  </a>
                )}
                <div
                  id="register-msg"
                  class="alert alert--bad"
                  role="alert"
                  hidden
                />
                <div style="display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:var(--dp-color-ground-muted);border:1px solid var(--dp-color-rule);border-radius:14px;margin-top:14px;font-size:12px;color:var(--dp-color-ink-secondary);line-height:1.45;">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    style="flex-shrink:0;margin-top:2px;"
                  >
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  <span>
                    Kuota diamankan secara adil melalui antrean real-time. Anda
                    memiliki waktu reservasi 30 menit untuk menyelesaikan data
                    dan pembayaran setelah kuota berhasil dikunci.
                  </span>
                </div>
              </div>
            </form>
          )
        }
      </aside>
    </div>
  </section>

  {
    related && related.length > 0 && (
      <section class="section section--muted">
        <div class="wrap">
          <>
            <h2>Event terkait</h2>
            <div class="grid grid--3">
              {related.map((e) => (
                <EventCard e={e} />
              ))}
            </div>
          </>
        </div>
      </section>
    )
  }
  <style>
    @media (max-width: 900px) {
      #detail-grid {
        grid-template-columns: 1fr !important;
      }
      #daftar {
        position: static !important;
      }
    }
  </style>
  <script>
    import "../../scripts/event-register.ts";
  </script>
</PublicLayout>
