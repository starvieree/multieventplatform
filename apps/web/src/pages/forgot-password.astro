---
import PublicLayout from '../layouts/PublicLayout.astro';
import FormField from '../components/FormField.astro';
import Alert from '../components/Alert.astro';
const sp = Astro.url.searchParams;
---
<PublicLayout title="Lupa kata sandi" noindex><section class="auth wrap"><div class="card"><h1 style="font-size:2rem">Lupa kata sandi</h1>
  {sp.get('sent') ? <Alert tone="ok">Jika email terdaftar, tautan untuk mengatur ulang kata sandi sudah dikirim.</Alert> : sp.get('error') ? <Alert tone="bad">Tautan sudah kedaluwarsa. Minta tautan baru.</Alert> : <p class="muted">Masukkan email akun Anda.</p>}
  <form class="form" method="post" action="/api/auth/forgot" style="margin-top:16px"><FormField name="email" type="email" label="Email" required autocomplete="email" /><button class="btn" type="submit">Kirim tautan</button></form>
  <p class="small" style="margin:16px 0 0"><a href="/login">Kembali ke halaman masuk</a></p></div></section></PublicLayout>
