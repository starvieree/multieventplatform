---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Badge from '../../components/Badge.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { fmtDate } from '../../lib/utils/format';

const sb = Astro.locals.supabase;
const { id } = Astro.params;
const { data: t } = await sb
  .from('tickets')
  .select('*, registration:registrations(registration_code, event:events(title, slug, start_at, end_at, event_type, venue_name, address, online_url))')
  .eq('id', id!)
  .maybeSingle();

if (!t) return Astro.rewrite('/404');
const ev = (t as any).registration?.event;
---

<PublicLayout title={`E-Ticket ${t.ticket_code}`}>
  <div class="wrap" style="padding: 28px 0 80px;">
    <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Tiket Saya', href: '/tiket-saya' }, { label: t.ticket_code }]} />

    <div style="max-width: 620px; margin: 28px auto 0;">
      <article
        class="card"
        style="padding: 36px 32px; border-radius: 24px; border: 1px solid var(--dp-color-rule); box-shadow: 0 16px 40px -12px rgba(15, 23, 42, 0.12); position: relative;"
      >
        <div class="row between" style="border-bottom: 1px dashed var(--dp-color-rule); padding-bottom: 18px; margin-bottom: 22px;">
          <div>
            <span class="meta" style="letter-spacing: 0.06em; font-weight: 700; color: var(--dp-color-accent); font-size: 11px;">
              OFFICIAL E-TICKET
            </span>
            <div style="font-weight: 700; font-size: 1.1rem; color: var(--dp-color-ink);">
              PlatformEvent<span class="brand-dot">.</span>
            </div>
          </div>
          <Badge status={t.status} />
        </div>

        <h1 style="font-size: clamp(1.4rem, 3vw, 1.75rem); font-weight: 750; margin: 0 0 18px; line-height: 1.3;">
          {ev?.title}
        </h1>

        <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 18px; padding: 20px; text-align: center; margin-bottom: 24px;">
          <span class="meta" style="font-size: 11.5px; color: #1e40af; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">
            KODE CHECK-IN RESMI
          </span>
          <p style="font: 800 2.2rem var(--font-display); letter-spacing: 0.1em; color: #1e3a8a; margin: 6px 0 0; font-family: monospace;">
            {t.ticket_code}
          </p>
        </div>

        <dl class="kv" style="gap: 12px 20px; font-size: 14px; margin-bottom: 24px;">
          <dt>Nama Peserta</dt>
          <dd><b>{t.attendee_name || '—'}</b></dd>
          <dt>Waktu Acara</dt>
          <dd><b>{ev?.start_at ? fmtDate(ev.start_at, true) : '—'} WIB</b></dd>
          <dt>Lokasi</dt>
          <dd>
            {ev?.event_type === 'online' ? '🟢 Online (Tautan akan dibagikan)' : [ev?.venue_name, ev?.address].filter(Boolean).join(', ') || 'Lokasi Acara'}
            {ev?.event_type !== 'offline' && ev?.online_url && (
              <> · <a href={ev.online_url} rel="noopener noreferrer" target="_blank" style="font-weight: 600;">Buka Tautan Acara ↗</a></>
            )}
          </dd>
          <dt>No. Registrasi</dt>
          <dd style="font-family: monospace;">{(t as any).registration?.registration_code}</dd>
          <dt>Tanggal Diterbitkan</dt>
          <dd>{fmtDate(t.issued_at, true)} WIB</dd>
        </dl>

        <div style="background: var(--dp-color-ground-muted); padding: 16px 18px; border-radius: 16px; margin-bottom: 24px; border: 1px solid var(--dp-color-rule);">
          <b style="font-size: 13.5px; display: block; margin-bottom: 4px; color: var(--dp-color-ink);">Instruksi Check-in Lokasi:</b>
          <p class="meta" style="margin: 0; line-height: 1.5; font-size: 13px;">
            Tunjukkan kode tiket ini pada layar ponsel Anda atau cetak PDF kepada panitia registrasi di pintu masuk. Satu kode hanya berlaku untuk satu kali pemindaian masuk.
          </p>
        </div>

        <div class="row" style="gap: 12px;">
          <button class="btn" style="flex: 1; padding: 12px; font-weight: 650;" type="button" onclick="window.print()">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9" />
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
              <rect width="12" height="8" x="6" y="14" />
            </svg>
            Cetak / Simpan PDF
          </button>
          <a class="btn btn--secondary" href="/tiket-saya" style="padding: 12px 18px;">Kembali</a>
        </div>
      </article>
    </div>
  </div>
</PublicLayout>
