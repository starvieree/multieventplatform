---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Badge from '../../components/Badge.astro';
import StateBox from '../../components/StateBox.astro';
import { fmtDate } from '../../lib/utils/format';

const sb = Astro.locals.supabase;
const { data: tickets, error } = await sb
  .from('tickets')
  .select('id, ticket_code, status, attendee_name, issued_at, registration:registrations(registration_code, event:events(title, slug, poster_path, start_at, end_at, event_type, venue_name, address))')
  .order('issued_at', { ascending: false });

const list = (tickets ?? []).map((t: any) => ({
  id: t.id,
  code: t.ticket_code,
  status: t.status,
  attendee: t.attendee_name,
  regCode: t.registration?.registration_code,
  event: t.registration?.event,
}));
---

<PublicLayout title="Tiket Saya">
  <div class="wrap" style="padding: 36px 0 80px;">
    <div style="margin-bottom: 32px; display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
          <h1 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); margin: 0;">Tiket Saya</h1>
          {list.length > 0 && <span class="badge badge--ok">{list.length} Tiket Diterbitkan</span>}
        </div>
        <p class="lead" style="margin: 0; font-size: 1rem;">
          Daftar e-ticket resmi Anda. Tunjukkan kode tiket atau barcode saat registrasi kedatangan di lokasi acara.
        </p>
      </div>

      <a class="btn btn--secondary btn--sm" href="/pesanan">
        Lihat Riwayat Pesanan →
      </a>
    </div>

    {error ? (
      <StateBox kind="error" title="Gagal memuat tiket" text="Terjadi kendala koneksi saat mengambil data tiket." action="Muat ulang" href="/tiket-saya" />
    ) : list.length === 0 ? (
      <StateBox
        title="Belum Ada Tiket yang Diterbitkan"
        text="Anda belum memiliki tiket acara aktif. Temukan berbagai event menarik dan amankan kuota Anda sekarang!"
        action="Jelajahi Event Pilihan"
        href="/events"
      />
    ) : (
      <div class="grid grid--2" style="gap: 24px;">
        {list.map((t) => (
          <article
            class="card"
            style="display: flex; flex-direction: column; justify-content: space-between; border-radius: 20px; overflow: hidden; border: 1px solid var(--dp-color-rule); box-shadow: 0 10px 28px -10px rgba(15, 23, 42, 0.08); transition: transform 0.2s ease;"
          >
            <div style="padding: 24px;">
              <div class="row between" style="margin-bottom: 14px;">
                <span class="meta" style="font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: var(--dp-color-accent); text-transform: uppercase;">
                  OFFICIAL E-TICKET
                </span>
                <Badge status={t.status} />
              </div>

              <h2 style="font-size: 1.25rem; font-weight: 750; line-height: 1.3; margin: 0 0 12px;">
                <a href={t.event?.slug ? `/events/${t.event.slug}` : '#'} style="color: var(--dp-color-ink); text-decoration: none;">
                  {t.event?.title ?? 'Event'}
                </a>
              </h2>

              <dl class="kv" style="font-size: 13.5px; margin-bottom: 20px; gap: 8px 16px;">
                <dt>Waktu Acara</dt>
                <dd><b>{t.event?.start_at ? fmtDate(t.event.start_at, true) : '—'} WIB</b></dd>
                <dt>Lokasi</dt>
                <dd>{t.event?.event_type === 'online' ? '🟢 Online Webinar' : [t.event?.venue_name, t.event?.address].filter(Boolean).join(', ') || 'Venue Acara'}</dd>
                <dt>Nama Peserta</dt>
                <dd>{t.attendee || '—'}</dd>
              </dl>

              <div style="background: var(--dp-color-ground-muted); border: 1px dashed var(--dp-color-rule); padding: 14px 18px; border-radius: 14px; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                <div>
                  <span class="meta" style="font-size: 11px; display: block; font-weight: 600; text-transform: uppercase;">Kode Check-in</span>
                  <b style="font-size: 1.25rem; font-family: monospace; letter-spacing: 0.06em; color: var(--dp-color-ink);">{t.code}</b>
                </div>
                <a class="btn btn--sm" href={`/tiket-saya/${t.id}`}>
                  Buka E-Ticket →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</PublicLayout>
