---
import PublicLayout from '../layouts/PublicLayout.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import EventCard from '../components/EventCard.astro';
import StateBox from '../components/StateBox.astro';
import { fmtDate, mediaUrl } from '../lib/utils/format';
const sb = Astro.locals.supabase;
const [featured, cats, posts, evCount] = await Promise.all([
  sb.from('event_listing').select('*').eq('status', 'published').order('start_at').limit(6),
  sb.from('event_categories').select('name,slug,description').eq('is_active', true).order('name').limit(8),
  sb.from('blogs').select('title,slug,excerpt,thumbnail_path,published_at,category').eq('status', 'published').order('published_at', { ascending: false }).limit(3),
  sb.from('event_listing').select('id', { count: 'exact', head: true }).eq('status', 'published'),
]);
// Statistik hanya angka nyata dari database; bila kosong, bagian ini tidak ditampilkan.
const facts = [[evCount.count, 'event dibuka'], [cats.data?.length, 'kategori event'], [posts.data?.length, 'artikel terbaru']].filter(([n]) => Number(n) > 0) as [number, string][];
const steps = [['Temukan event', 'Cari berdasarkan kategori, tanggal, lokasi, atau harga.'], ['Daftar dan isi data', 'Masuk, pilih tiket, lalu isi formulir saat kuota Anda sudah diamankan.'], ['Selesaikan pembayaran', 'Bayar lewat Midtrans bila event berbayar. Status berubah otomatis.'], ['Pantau status dan tiket', 'Lihat antrean, pendaftaran, dan tiket kapan saja dari dashboard.']];
const benefits = [['Informasi terpusat', 'Jadwal, lokasi, tiket, dan syarat peserta ada di satu halaman event.'], ['Pendaftaran terstruktur', 'Antrean menjaga urutan dan kuota tetap akurat saat pendaftaran ramai.'], ['Status dapat dipantau', 'Setiap tahap tercatat: antrean, reservasi, pembayaran, hingga tiket.'], ['Pembayaran terintegrasi', 'Konfirmasi datang dari penyedia pembayaran, bukan dari bukti transfer manual.']];
---
<PublicLayout title="Platform Event — daftar event dengan kuota yang dijaga">
  <section class="hero"><div class="wrap">
    <div class="hero__grid">
      <div>
        <h1>Daftar event tanpa ragu soal kuota dan pembayaran.</h1>
        <p class="lead">Satu tempat untuk menemukan event, mengamankan tiket lewat antrean yang adil, membayar, dan memantau statusnya.</p>
        <div class="row hero__actions"><a class="btn" href="/events">Jelajahi event</a><a class="btn btn--secondary" href="/tentang">Pelajari platform</a></div>
        <form class="search" action="/events" method="get" role="search" aria-label="Cari event">
          <div><label class="sr-only" for="hq">Kata kunci</label><input class="input" id="hq" name="q" placeholder="Cari nama event" maxlength="80" /></div>
          <div><label class="sr-only" for="hc">Kategori</label><select class="input" id="hc" name="category"><option value="">Semua kategori</option>{cats.data?.map((c) => <option value={c.slug}>{c.name}</option>)}</select></div>
          <button class="btn" type="submit">Cari</button>
        </form>
      </div>
      <HeroDiagram />
    </div>
    {facts.length > 0 && <div class="facts">{facts.map(([n, l]) => <div><b>{n}</b><span class="muted small">{l}</span></div>)}</div>}
  </div></section>

  {cats.data && cats.data.length > 0 && <section class="section section--muted"><div class="wrap">
    <div class="section-head"><h2>Kategori event</h2><p class="lead">Mulai dari topik yang Anda minati.</p></div>
    <div class="grid grid--4">{cats.data.map((c) => <a class="card cat-tile" href={`/events?category=${c.slug}`}><h3>{c.name}</h3><p class="muted small" style="margin:0">{c.description ?? 'Lihat event dalam kategori ini.'}</p></a>)}</div>
  </div></section>}

  <section class="section"><div class="wrap">
    <div class="section-head"><h2>Event unggulan</h2><p class="lead">Hanya event yang sedang dibuka untuk pendaftaran.</p></div>
    {featured.error ? <StateBox kind="error" title="Event belum dapat dimuat" text="Muat ulang halaman ini beberapa saat lagi." href="/" action="Muat ulang" />
     : featured.data?.length ? <div class="grid grid--3">{featured.data.map((e) => <EventCard e={e} />)}</div>
     : <StateBox title="Belum ada event yang dibuka" text="Event baru akan muncul di sini begitu pendaftarannya dibuka." href="/partnership" action="Jadi mitra penyelenggara" />}
    {featured.data?.length ? <p style="margin-top:28px"><a class="btn btn--secondary" href="/events">Lihat semua event</a></p> : null}
  </div></section>

  <section class="section section--dark on-dark"><div class="wrap">
    <div class="section-head"><h2 style="color:#fff">Cara kerja</h2><p class="lead">Dari menemukan event sampai tiket terbit, setiap langkah bisa dipantau.</p></div>
    <ol class="steps">{steps.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
    <div class="section-head"><h2 style="color:#fff">Kenapa memakai platform ini</h2><p></p></div>
    <ul class="feature-list">{benefits.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ul>
  </div></section>

  {posts.data && posts.data.length > 0 && <section class="section section--muted"><div class="wrap">
    <div class="section-head"><h2>Artikel terbaru</h2><p class="lead">Panduan dan cerita seputar penyelenggaraan event.</p></div>
    <div class="grid grid--3">{posts.data.map((p) => <article class="card event-card">
      {mediaUrl(p.thumbnail_path) ? <img class="event-card__img" src={mediaUrl(p.thumbnail_path)!} alt="" width="640" height="360" loading="lazy" /> : <div class="event-card__ph" aria-hidden="true">{p.title[0]}</div>}
      <div class="event-card__body"><span class="meta">{fmtDate(p.published_at)}</span><h3><a href={`/blog/${p.slug}`}>{p.title}</a></h3><p class="muted small" style="margin:0">{p.excerpt}</p></div></article>)}</div>
  </div></section>}

  <section class="section section--dark on-dark"><div class="wrap">
    <div class="section-head" style="margin:0"><h2 style="color:#fff">Siap mendaftar atau menyelenggarakan event?</h2>
      <div class="row"><a class="btn" href="/events">Jelajahi event</a><a class="btn btn--secondary" href="/register">Buat akun</a></div></div>
  </div></section>
</PublicLayout>
