---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Pagination from '../../components/Pagination.astro';
import StateBox from '../../components/StateBox.astro';
import { fmtDate, mediaUrl } from '../../lib/utils/format';
const sb = Astro.locals.supabase, sp = Astro.url.searchParams;
const q = (sp.get('q') ?? '').replace(/[,()%*\\]/g, ' ').trim().slice(0, 80), cat = (sp.get('category') ?? '').slice(0, 60);
const page = Math.max(1, Number(sp.get('page') ?? 1) || 1), size = 9;
let query = sb.from('blogs').select('title,slug,excerpt,thumbnail_path,published_at,category', { count: 'exact' }).eq('status', 'published');
if (q) query = query.or(`title.ilike.%${q}%,excerpt.ilike.%${q}%`); if (cat) query = query.eq('category', cat);
const { data, count, error } = await query.order('published_at', { ascending: false }).range((page - 1) * size, page * size - 1);
const { data: allCats } = await sb.from('blogs').select('category').eq('status', 'published').not('category', 'is', null);
const cats = [...new Set((allCats ?? []).map((c) => c.category as string))];
const [lead, ...rest] = page === 1 && !q && !cat ? data ?? [] : [undefined, ...(data ?? [])];
---
<PublicLayout title="Blog" description="Artikel dan panduan seputar penyelenggaraan dan pendaftaran event.">
  <section class="section--tight"><div class="wrap"><Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Blog' }]} /><h1 style="margin-top:20px">Blog</h1></div></section>
  <section class="section" style="padding-top:8px"><div class="wrap">
    <form class="row" method="get" role="search" style="margin-bottom:24px"><div class="field" style="flex:1;min-width:220px"><label class="sr-only" for="bq">Cari artikel</label><input class="input" id="bq" name="q" value={q} placeholder="Cari artikel" /></div>
      <div class="field"><label class="sr-only" for="bc">Kategori</label><select class="input" id="bc" name="category"><option value="">Semua kategori</option>{cats.map((c) => <option selected={c === cat}>{c}</option>)}</select></div><button class="btn">Cari</button></form>
    {error ? <StateBox kind="error" title="Artikel belum dapat dimuat" href="/blog" action="Muat ulang" /> : !data?.length ? <StateBox title="Belum ada artikel" text="Coba kata kunci atau kategori lain." href="/blog" action="Reset" /> : <>
      {lead && <article class="card" style="display:grid;grid-template-columns:1fr 1fr;margin-bottom:24px" id="lead">{mediaUrl(lead.thumbnail_path) ? <img src={mediaUrl(lead.thumbnail_path)!} alt="" style="width:100%;height:100%;object-fit:cover;filter:grayscale(1)" width="640" height="360" /> : <div class="event-card__ph">{lead.title[0]}</div>}
        <div class="card__body" style="padding:32px"><span class="meta">{lead.category} · {fmtDate(lead.published_at)}</span><h2 style="margin-top:8px"><a style="color:inherit;text-decoration:none" href={`/blog/${lead.slug}`}>{lead.title}</a></h2><p class="muted">{lead.excerpt}</p><a class="btn btn--secondary btn--sm" href={`/blog/${lead.slug}`}>Baca artikel</a></div></article>}
      <div class="grid grid--3">{rest.map((p) => <article class="card event-card">{mediaUrl(p.thumbnail_path) ? <img class="event-card__img" src={mediaUrl(p.thumbnail_path)!} alt="" width="640" height="360" loading="lazy" /> : <div class="event-card__ph">{p.title[0]}</div>}
        <div class="event-card__body"><span class="meta">{p.category} · {fmtDate(p.published_at)}</span><h3><a href={`/blog/${p.slug}`}>{p.title}</a></h3><p class="muted small" style="margin:0">{p.excerpt}</p></div></article>)}</div>
      <Pagination page={page} total={count ?? 0} pageSize={size} /></>}
  </div></section>
  <style>@media (max-width: 760px) { #lead { grid-template-columns: 1fr !important; } }</style>
</PublicLayout>
