---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { fmtDate, mediaUrl } from '../../lib/utils/format';
import { renderMarkdown } from '../../lib/utils/markdown';

const sb = Astro.locals.supabase;
const { data: post } = await sb.from('blogs').select('*').eq('slug', Astro.params.slug!).eq('status', 'published').maybeSingle();
if (!post) return Astro.rewrite('/404');

const { data: related } = await sb.from('blogs').select('title,slug,published_at,category').eq('status', 'published').neq('id', post.id).order('published_at', { ascending: false }).limit(3);
const html = renderMarkdown(post.content);
const img = mediaUrl(post.thumbnail_path);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: post.title, datePublished: post.published_at, dateModified: post.updated_at, image: img ? [img] : undefined, description: post.excerpt ?? undefined };
---

<PublicLayout title={post.meta_title || post.title} description={post.meta_description || post.excerpt || undefined} image={img} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Blog', href: '/blog' }, { label: post.title }]} />
  </div>

  <article class="section" style="padding-top: 24px; padding-bottom: 64px;">
    <div class="wrap" style="max-width: 820px;">
      <div style="margin-bottom: 20px;">
        {post.category && (
          <span class="badge badge--ok" style="font-size: 12px; padding: 4px 12px; margin-bottom: 12px;">
            {post.category}
          </span>
        )}
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; margin: 8px 0 12px;">
          {post.title}
        </h1>
        <span class="meta" style="font-size: 14px;">
          Dipublikasikan pada {fmtDate(post.published_at)}
        </span>
      </div>

      {img && (
        <div style="border-radius: 20px; overflow: hidden; margin: 24px 0 32px; box-shadow: 0 12px 32px -10px rgba(15, 23, 42, 0.1);">
          <img
            style="width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;"
            src={img}
            alt={`Thumbnail ${post.title}`}
            width="960"
            height="540"
          />
        </div>
      )}

      <div class="prose" set:html={html} style="font-size: 16.5px; line-height: 1.75;" />
    </div>
  </article>

  {related && related.length > 0 && (
    <section class="section section--muted">
      <div class="wrap" style="max-width: 820px;">
        <h2 style="font-size: 1.4rem; margin-bottom: 18px;">Artikel Terkait Lainnya</h2>
        <div class="stack" style="gap: 12px;">
          {related.map((r) => (
            <div class="card" style="padding: 16px 20px; border-radius: 14px;">
              <div class="row between">
                <a href={`/blog/${r.slug}`} style="font-weight: 650; font-size: 1.05rem; color: var(--dp-color-ink); text-decoration: none;">
                  {r.title}
                </a>
                <span class="meta" style="font-size: 12.5px;">{fmtDate(r.published_at)}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="promoter-banner">
        <div>
          <h2>Temukan Event Favorit Anda Berikutnya</h2>
          <p>
            Jelajahi ratusan jadwal workshop, konferensi teknologi, dan seminar bisnis dengan kuota yang terjaga.
          </p>
        </div>
        <div class="promoter-banner__actions">
          <a class="btn btn--white" href="/events">
            Jelajahi Katalog Event →
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
