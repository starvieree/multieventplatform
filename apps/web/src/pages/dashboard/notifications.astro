---
import PanelLayout from '../../layouts/PanelLayout.astro';
import StateBox from '../../components/StateBox.astro';
import Pagination from '../../components/Pagination.astro';
import { fmtDate } from '../../lib/utils/format';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1), size = 15;
const { data, count } = await Astro.locals.supabase.from('notifications').select('*', { count: 'exact' }).order('created_at', { ascending: false }).range((page - 1) * size, page * size - 1);
---
<PanelLayout title="Notifikasi" variant="participant" crumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Notifikasi' }]}>
  <h1>Notifikasi</h1><div class="stack" style="margin-top:16px">
  {data?.length ? data.map((n) => <article class="card card--pad" data-id={n.id} data-unread={n.read_at ? '0' : '1'}><div class="row between"><b>{n.title}</b>{!n.read_at && <span class="badge badge--ok">Baru</span>}</div><p class="muted" style="margin:6px 0">{n.body}</p><span class="meta">{fmtDate(n.created_at, true)}</span>{!n.read_at && <div style="margin-top:8px"><button class="btn btn--secondary btn--sm" data-read={n.id} type="button">Tandai dibaca</button></div>}</article>) : <StateBox title="Belum ada notifikasi" text="Status antrean, pembayaran, dan tiket akan muncul di sini." />}</div>
  <Pagination page={page} total={count ?? 0} pageSize={size} />
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-read]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const r = await fetch(`/api/v1/me/notifications/${b.dataset.read}/read`, { method: 'PATCH' });
      if (r.ok) { b.closest('article')?.querySelector('.badge')?.remove(); b.remove(); } else b.disabled = false;
    }));
  </script>
</PanelLayout>
