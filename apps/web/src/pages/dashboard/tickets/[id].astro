---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import Badge from '../../../components/Badge.astro';
import { fmtDate } from '../../../lib/utils/format';
const { data: t } = await Astro.locals.supabase.from('tickets').select('*, registration:registrations(registration_code, event:events(title,start_at,end_at,venue_name,address))').eq('id', Astro.params.id!).maybeSingle();
if (!t) return Astro.rewrite('/404');
const ev = (t as any).registration.event;
---
<PanelLayout title={`Tiket ${t.ticket_code}`} variant="participant" crumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Tiket', href: '/dashboard/tickets' }, { label: t.ticket_code }]}>
  <article class="card card--pad" style="max-width:560px"><div class="row between"><span class="meta">Tiket</span><Badge status={t.status} /></div>
    <h1 style="margin-top:8px">{ev.title}</h1>
    <p style="font:700 1.6rem var(--font-display);letter-spacing:.04em;margin:8px 0 16px">{t.ticket_code}</p>
    <dl class="kv"><dt>Peserta</dt><dd>{t.attendee_name ?? '—'}</dd><dt>Waktu</dt><dd>{fmtDate(ev.start_at, true)} WIB</dd><dt>Lokasi</dt><dd>{[ev.venue_name, ev.address].filter(Boolean).join(', ') || '—'}</dd><dt>Kode pendaftaran</dt><dd>{(t as any).registration.registration_code}</dd></dl>
    <p class="meta" style="margin-top:16px">Tunjukkan kode tiket ini kepada panitia saat check-in.</p></article>
</PanelLayout>
