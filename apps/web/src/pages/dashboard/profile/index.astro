---
import PanelLayout from '../../../layouts/PanelLayout.astro';
import FormField from '../../../components/FormField.astro';
const { data: p } = await Astro.locals.supabase.from('profiles').select('full_name,phone,email').eq('id', Astro.locals.user!.id).maybeSingle();
---
<PanelLayout title="Profil" variant="participant" crumbs={[{ label: 'Dashboard', href: '/dashboard' }, { label: 'Profil' }]}>
  <h1>Profil</h1>
  <form class="form card card--pad" style="max-width:560px;margin-top:16px" data-json-form data-method="PATCH" data-endpoint="/api/v1/me" data-success="Profil diperbarui.">
    <FormField name="email" type="email" label="Email" value={p?.email} hint="Email diubah lewat pengaturan akun dan perlu verifikasi." /><FormField name="full_name" label="Nama lengkap" value={p?.full_name} required autocomplete="name" /><FormField name="phone" type="tel" label="Telepon" value={p?.phone} autocomplete="tel" />
    <div data-feedback hidden></div><button class="btn" type="submit">Simpan perubahan</button></form>
  <script>import '../../../scripts/json-form.ts';
    document.getElementById('f-email')?.setAttribute('disabled', 'true');</script>
</PanelLayout>
