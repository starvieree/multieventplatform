{ "name": "multi-event-platform", "private": true, "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build -w apps/web && npm run build -w apps/worker",
    "build:worker": "npm run build -w apps/worker",
    "build:web": "npm run build -w apps/web",
    "start": "node apps/worker/dist/src/index.js",
    "start:worker": "npm run start -w apps/worker",
    "start:web": "npm run start -w apps/web",
    "test": "npm run test -w apps/web",
    "typecheck": "npm run check -w apps/web && npm run typecheck -w apps/worker"
  },
  "engines": { "node": ">=20" } }
